#!/bin/bash
set -eu

{{ if eq .chezmoi.os "linux" }}
{{   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
{{     if ne (env "REMOTE_CONTAINERS") "true" }}

systemctl --user disable --now ssh-agent 2>/dev/null || true
systemctl --user enable bitwarden-ssh-agent
systemctl --user start bitwarden-ssh-agent

sudo systemctl enable my-settings.service
sudo systemctl enable docker

# run_once_10 が置いたブートストラップ用の NOPASSWD ドロップインを撤去する。
# ここまで到達したらブートストラップは完了しており、無認証 sudo を残す理由はない。
sudo rm -f /etc/sudoers.d/00-chezmoi-bootstrap

{{     end }}
{{   end }}
{{ end }}
