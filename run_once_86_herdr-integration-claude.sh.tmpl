#!/bin/bash
set -eu

# brew を PATH に載せないと brew 導入の herdr が見つからず、Claude Code 統合がスキップされる
{{ template "brew-env.sh" }}
if command -v herdr >/dev/null 2>&1; then
  echo "herdr: Claude Code統合をインストール"
  herdr integration install claude
else
  echo "herdr が見つからないため herdr integration install claude をスキップ"
fi
