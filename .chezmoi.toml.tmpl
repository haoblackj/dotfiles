{{- $isWSL := false -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $isWSL = contains "microsoft" (.chezmoi.kernel.osrelease | lower) -}}
{{- end -}}

{{- /* 自宅 PC の判定は Windows 側の USERDOMAIN が HIRO であること。Windows では env で
      そのまま取れる。WSL 側はユーザー名を yagu001 に統一していて、Windows 側のユーザー名も
      USERDOMAIN も env 経由では取れない（WSLENV で明示共有した変数しか渡らない）ので、
      WSL インタロップ経由で powershell.exe を 1 回だけ叩いて 2 つまとめて取る。
      SSH ログイン等で /mnt/c が PATH に無く powershell.exe が見つからないときは、
      init の 1 回だけ対話で聞く（prompt*Once は既存の設定値があればそれを使う）。 */ -}}
{{- $windowsUsername := "" -}}
{{- $isHome := false -}}
{{- if $isWSL -}}
    {{- if lookPath "powershell.exe" -}}
        {{- $ps := output "powershell.exe" "-NoProfile" "-Command" "$env:UserName; $env:USERDOMAIN" | trim | splitList "\n" -}}
        {{- $windowsUsername = index $ps 0 | trim -}}
        {{- $isHome = eq (index $ps 1 | trim) "HIRO" -}}
    {{- else -}}
        {{- $windowsUsername = promptStringOnce . "windowsUsername" "Windows 側のユーザー名（powershell.exe が PATH に無いため手入力）" -}}
        {{- $isHome = promptBoolOnce . "isHome" "自宅 PC か（Windows 側の USERDOMAIN が HIRO なら y。powershell.exe が PATH に無いため手入力）" false -}}
    {{- end -}}
{{- else -}}
    {{- $isHome = eq (env "USERDOMAIN") "HIRO" -}}
{{- end -}}

{{- $location := "work" -}}
{{- if $isWSL -}}
    {{- $location = "wsl" -}}
{{- else if $isHome -}}
    {{- $location = "home" -}}
{{- end -}}

# SSHログインでは pam_umask が /etc/login.defs の USERGROUPS_ENAB=yes を見て
# umask を 022 から 002 へ緩めるため、wsl.exe からの通常起動（022）と食い違う。
# chezmoi は実行時の umask からターゲットの期待モードを算出するので、固定しないと
# 入口によって管理下の全ファイルが差分扱いになる。
umask = 0o022

[data]
    location = {{ $location | quote }}
    isWSL = {{ $isWSL }}
    # devcontainer は WSL のカーネルを共有するので isWSL が真になる。run_once の実行可否
    # （.chezmoiignore）と .zshrc の wsl_only.zsh 読み込みは、この 2 つの組で判定する。
    isDevcontainer = {{ eq (env "REMOTE_CONTAINERS") "true" }}
    windowsUsername = {{ $windowsUsername | quote }}
    # 自宅 PC（Windows 側の USERDOMAIN が HIRO）。Bitwarden 関連（SSH agent の unit と
    # 起動、bitwarden-cli、zsh の SSH_AUTH_SOCK）は自宅以外では配らず走らせない。
    # 職場機では npiperelay.exe 経由の agent がマルウェア検知に当たるため。
    isHome = {{ $isHome }}

[edit]
    command = "code"
    args = ["--wait"]

[merge]
    command = "code"
    args = ["--wait", "--diff", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Source {{ "}}" }}"]

[diff]
    command = "delta"

# 毎回走るスクリプト（run_after_99_remove-bootstrap-sudo.sh）は status に常に R で載り、
# zsh 起動時のドリフト検知が毎回「実行待ち」を出してしまう。status からだけ除外する
# （apply では走る）。
[status]
    exclude = ["always"]