#!/bin/bash
set -eu

{{ if eq .chezmoi.os "linux" }}
{{   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
{{     if ne (env "REMOTE_CONTAINERS") "true" }}

# 非インタラクティブシェルでは .profile が読まれないため brew を PATH に追加
if [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

if command -v uv >/dev/null 2>&1; then
  echo "wikiwalkインストール（uv tool install）"
  uv tool install --force git+https://github.com/haoblackj/wikiwalk
else
  echo "uv が見つからないため wikiwalk のインストールをスキップ"
fi

{{     end }}
{{   end }}
{{ end }}
