#!/bin/bash
set -eu

{{ if eq .chezmoi.os "linux" }}
{{   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
{{     if ne (env "REMOTE_CONTAINERS") "true" }}

# 非インタラクティブシェルでは .profile が読まれないため brew を PATH に追加
if [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# wikiwalk のリモート HEAD を埋め込む。更新が入るとこのスクリプトの内容が変わり、
# run_onchange により再インストールが走る。git ls-remote でなく gh api を使うのは、
# git の credential helper 設定に依存せず run_once_85_gh-setup.sh のログインだけで通るため。
# output は chezmoi 本体のプロセスで走り、その PATH には brew の gh が載らない（本体の
# brew shellenv はスクリプト実行時の話で展開時には効かない）ため、gh はフルパスで呼ぶ。
# gh 未導入の apply（run_once_80 到達前）でテンプレートごと落ちないよう stat で存在を確認し、
# 未導入なら pending を埋める。gh 導入後の apply で実 SHA に変わり、内容変化で再走する。
# wikiwalk HEAD: {{ if stat "/home/linuxbrew/.linuxbrew/bin/gh" }}{{ output "/home/linuxbrew/.linuxbrew/bin/gh" "api" "repos/haoblackj/wikiwalk/commits/HEAD" "--jq" ".sha" | trim }}{{ else }}pending{{ end }}
if command -v uv >/dev/null 2>&1; then
  echo "wikiwalkインストール（uv tool install）"
  uv tool install --force git+https://github.com/haoblackj/wikiwalk
else
  echo "uv が見つからないため wikiwalk のインストールをスキップ"
fi

{{     end }}
{{   end }}
{{ end }}
