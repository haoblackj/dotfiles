[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
# アプリが書き戻す JSON のキー順を index 側で正規化する（chezmoi ソースの .gitattributes が参照）
[filter "jsonsort"]
    clean = jq -S .
[user]
    name = haoblackj
    email = 17177994+haoblackj@users.noreply.github.com
[core]
    autocrlf = false
    quotepath = false
[credential]
    helper = "/mnt/c/Users/{{ .windowsUsername }}/scoop/apps/git/current/mingw64/bin/git-credential-manager.exe"
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[alias]
    cob = checkout -b
    co = checkout
[ghq]
    root = ~/repo
[pull]
    rebase = false