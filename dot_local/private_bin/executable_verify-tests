# 判定に算入しないもの。テスト以外の経路で日常的に変わるため。
# memory_recall.py が UserPromptSubmit フックとして書くので、
# テストの実行中に別のセッションでプロンプトが走れば変化する。
DEFAULT_WATCHED_EXCLUDE = [
    os.path.expanduser("~/.claude/logs/memory-recall.log*"),
    os.path.expanduser("~/.claude/projects/*/memory/.embeddings.json*"),
    os.path.expanduser("~/.claude/projects/*/memory/*.md"),
]


def _env_list(name, default):
    raw = os.environ.get(name)
    if raw is None:
        return default
    return [p for p in raw.split("\n") if p.strip()]


def _expand(patterns):
    out = set()
    for pat in patterns:
        for hit in glob.glob(pat):
            if os.path.isdir(hit):
                for root, dirs, files in os.walk(hit):
                    dirs[:] = [d for d in dirs if d != ".git"]
                    for f in files:
                        out.add(os.path.join(root, f))
            else:
                out.add(hit)
    return out


def snapshot_watched():
    snap = {}
    for path in _expand(_env_list("VERIFY_TESTS_WATCHED", DEFAULT_WATCHED)):
        try:
            st = os.stat(path)
        except OSError:
            continue
        snap[path] = (st.st_mtime_ns, st.st_size)
    return snap


def diff_watched(before, after):
    """変化を「判定に算入するもの」と「但し書き」に分ける。

    除外にあるファイルの変化も報告する。黙って捨てない。
    """
    excluded = _expand(_env_list("VERIFY_TESTS_WATCHED_EXCLUDE",
                                 DEFAULT_WATCHED_EXCLUDE))
    counted, noted = [], []
    for path in sorted(set(before) | set(after)):
        if before.get(path) == after.get(path):
            continue
        (noted if path in excluded else counted).append(path)
    return counted, noted


def main(argv):
    if "--selftest-normalize" in argv:
        i = argv.index("--selftest-normalize")
        print(normalize(argv[i + 1]))
        return 0

    if "--print-binds" in argv:
        for p in RO_BINDS:
            print(p)
        return 0

    positional = [a for a in argv if not a.startswith("-")]
    if not positional:
        print("使い方: verify-tests <リポジトリ> [--strict] [--discover-only] [-- <pytest への引数>]")
        return 1
    repo = os.path.abspath(positional[0])

    if not in_scope(repo):
        print(f"対象外: {repo}（読み取り専用 bind の一覧を持たないので検査しない）")
        return 0

    print(f"== 対象: {repo}")
    if not bwrap_available():
        print("実行できなかった: bwrap が PATH にありません。"
              "`sudo apt install bubblewrap` で導入してください")
        return 1

    before = snapshot_watched()
    sandbox = make_sandbox_home()
    try:
        if not sandbox_started(repo, sandbox):
            print("実行できなかった: bwrap の起動に失敗しました")
            return 1
        tracked = tracked_files(repo, sandbox)
        if tracked is None:
            print("実行できなかった: git ls-files が失敗しました")
            return 1
        py, sh = target_tests(repo, tracked)
        print(f"== 対象: Python {len(py)}ファイル / shell {len(sh)}ファイル")
        rc_collect, collected, _ = collected_files(repo, sandbox)

        problems = check_discovery_policy(repo)
        for p in problems:
            print(f"== discovery: {p}")
        missing, unexpected = collection_diff(repo, py, collected)
        for m in missing:
            print(f"== 走らなかった: {m}（候補にあるが収集されていない）")
        for u in unexpected:
            print(f"== 収集されたが候補に無い: {u}")

        rc_run, run_out = run_python(repo, sandbox)
        print(f"== 収集: {len(collected)}ファイル")
        print(f"== Python: rc={rc_run}")

        sh_results = run_shell(repo, sandbox, sh)
        green = sum(1 for rc in sh_results.values() if rc == 0)
        print(f"== shell: {green}/{len(sh_results)} 緑（ファイル単位・Level 1）")
        if SHELL_EXCLUDED:
            print(f"== shell 対象外: {', '.join(sorted(SHELL_EXCLUDED))}"
                  "（#20 が閉じるまで隔離下の挙動を測れないため）")

        after = snapshot_watched()
        counted, noted = diff_watched(before, after)
        for path in counted:
            print(f"== 本番へ書いた: {path}")
        for path in noted:
            print(f"== 変化（判定に算入しない）: {path}")
        return 0
    finally:
        shutil.rmtree(sandbox, ignore_errors=True)


sys.exit(main(sys.argv[1:]))
