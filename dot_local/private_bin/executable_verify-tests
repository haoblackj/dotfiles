def normalize(url):
    """origin の URL を <所有者>/<リポジトリ名> へ揃える。

    表記が1文字違うだけで「対象外」に落ち、何も検査せずに通るので、
    ここを省くと issue #15 の型をこの道具自身が作る。
    """
    s = re.sub(r"^[a-z][a-z0-9+.-]*://", "", url)
    s = re.sub(r"^[^@/]*@", "", s)
    s = re.sub(r"^[^/:]+[:/]", "", s)
    s = re.sub(r"\.git$", "", s)
    return s.rstrip("/")


def origin_of(repo):
    out = subprocess.run(
        ["git", "-C", repo, "remote", "get-url", "origin"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        return None
    return out.stdout.strip()


def in_scope(repo):
    url = origin_of(repo)
    if url is None:
        return False
    return normalize(url) in SCOPE


def git_common_dir(repo):
    """ワークツリーの場合はメイン側の .git を返す。

    --path-format=absolute を省くと非ワークツリーで相対パスが返り、
    bind に使えない。
    """
    out = subprocess.run(
        ["git", "-C", repo, "rev-parse", "--path-format=absolute",
         "--git-common-dir"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        return None
    return out.stdout.strip()


def match_any(basename, patterns):
    return any(re.match(p, basename) for p in patterns)


def target_tests(repo, tracked):
    """追跡ファイルの一覧から Python と shell の対象を選ぶ。

    規則は basename へ当てる。パス全体への部分一致にすると
    diet/scripts/latest_report.py のような無関係なファイルを拾う。
    """
    py, sh = [], []
    for path in tracked:
        base = os.path.basename(path)
        if match_any(base, PY_PATTERNS):
            py.append(path)
        elif match_any(base, SH_PATTERNS) and path not in SHELL_EXCLUDED:
            sh.append(path)
    return sorted(py), sorted(sh)


# penguinEx の pyproject.toml が持つべき norecursedirs。
# 既定値から .* だけを外し、残りは引き継いでいる。
EXPECTED_NORECURSEDIRS = [
    "*.egg", "_darcs", "build", "CVS", "dist", "node_modules", "venv", "{arch}",
    "__pycache__", ".git", ".worktrees", "worktrees", ".venv", ".pytest_cache",
    ".superpowers", ".github",
]


def check_discovery_policy(repo):
    """設定の内容そのものを検査する。

    期待値を「テストの一覧」ではなく「設定の内容」に持つので腐敗しない。
    台帳を持つ道を避けたのはこのため。
    """
    import tomllib
    path = os.path.join(repo, "pyproject.toml")
    if not os.path.exists(path):
        return ["pyproject.toml がありません"]
    with open(path, "rb") as f:
        conf = tomllib.load(f)
    opts = conf.get("tool", {}).get("pytest", {}).get("ini_options", {})
    problems = []
    if "norecursedirs" in opts:
        got = list(opts["norecursedirs"])
        if got != EXPECTED_NORECURSEDIRS:
            missing = [d for d in EXPECTED_NORECURSEDIRS if d not in got]
            extra = [d for d in got if d not in EXPECTED_NORECURSEDIRS]
            problems.append(
                f"norecursedirs が期待値と違います（不足 {missing} / 余分 {extra}）"
            )
    elif "testpaths" not in opts:
        problems.append("norecursedirs も testpaths もありません")
    return problems


def collection_diff(repo, py_targets, collected):
    """候補と収集結果を両方向で突き合わせる。

    片方向だけだと、ワークツリーの混入や gitignore された場所に置かれた
    test_*.py のように逆向きでしか見えない事故を見逃す。
    """
    want = {os.path.normpath(os.path.join(repo, p)) for p in py_targets}
    return sorted(want - collected), sorted(collected - want)


