# shell 向けの変異規則。**道具に埋め込む。**別ファイルで配ると、道具本体と規則で
# 配置経路が2つになる（#14/#15 が「道具は1本」と決めている）。
#
# 書式は universalmutator の `<正規表現> ==> <置換>`。`" ==> "` を含まず `#` で
# 始まる行はコメントとして黙って読み飛ばされる（mutator.parseRules、ソースで確認）。
# **コメントの中に ` ==> ` を書いてはいけない。**規則として解釈される。
#
# 同梱の universal.rules は使わない。C 系の演算子向けで、check-issues.sh を
# 対象にした実測では350件のうち生き残り117件がシェバンの `#!/usr/bin/env` や
# `rm -f` の破壊、C 風の `break;` の挿入で、スコア0.579はその雑音で決まっていた。
#
# **語境界を含めて書く。**概念実証の20行では `-n` の規則が `-ne` の内部に当たり、
# `-ze` という壊れた変異体が生まれた（実測）。構文が通らない変異体は実行すれば
# 必ず非0になり、analyze_mutants に kill と計上されて点数を持ち上げる。
# `-` は語構成文字ではないので `\b` では境界にならない。前後を明示で否定する。
SHELL_RULES = r"""
# コメントより後ろは変異させない。universalmutator はこの規則を「当たった位置より
# 後ろを変異させない」と解釈する（mutator.py の skipPos）。実測では penguinEx の
# shell 対象でコメント行の変異33件がこれで落ちる。
#
# **`#` 単体では書けない。**shell の `#` はコメント専用ではないので、`$#`・
# `${#arr[@]}`・`${var#接頭辞}` を含む行の変異が丸ごと消える。実測で消えていたのは
# 「引数が無いとき」「配列が空のとき」の門4箇所・10変異体で、テストがその経路を
# 踏んでいるかを測るのに最も効く行だった。直前の1文字で除く。
(?<![\w${])# ==> SKIP_MUTATING_REST

# 数値比較の演算子の入れ替え
(?<![\w-])-eq(?![\w-]) ==> -ne
(?<![\w-])-ne(?![\w-]) ==> -eq
(?<![\w-])-lt(?![\w-]) ==> -ge
(?<![\w-])-ge(?![\w-]) ==> -lt
(?<![\w-])-gt(?![\w-]) ==> -le
(?<![\w-])-le(?![\w-]) ==> -gt

# 文字列の空判定の反転
(?<![\w-])-z(?![\w-]) ==> -n
(?<![\w-])-n(?![\w-]) ==> -z

# && と || の入れ替え
&& ==> ||
\|\| ==> &&

# exit と return の終了コードの入れ替え
(?<![\w-])exit\s+0(?![\w]) ==> exit 1
(?<![\w-])exit\s+1(?![\w]) ==> exit 0
(?<![\w-])return\s+0(?![\w]) ==> return 1
(?<![\w-])return\s+1(?![\w]) ==> return 0

# 条件の否定の除去
(?<![\w-])(if\s+)!\s+ ==> \1
(?<![\w-])(while\s+)!\s+ ==> \1
(\[\[\s+)!\s+ ==> \1
(\[\s+)!\s+ ==> \1

# 数値リテラルの置き換え。リダイレクト（2>&1）と識別子の中の数字（python3）は
# 除く。どちらも変異させても意味が無く、生き残りを雑音で埋める。
(?<![\w.$/&<>-])\d+(?![\w.<>]) ==> 0
(?<![\w.$/&<>-])\d+(?![\w.<>]) ==> 1
"""

# 同梱の Python 向け規則。venv の中の実体を引く。Python のマイナー版で
# ディレクトリ名が変わるので glob で解決する。
BUNDLED_PYTHON_RULES_GLOB = os.path.join(
    MUTATE_VENV, "lib", "python*", "site-packages",
    "universalmutator", "static", "python.rules")


def bundled_python_rules(pattern=BUNDLED_PYTHON_RULES_GLOB):
    hits = sorted(glob.glob(pattern))
    if not hits:
        raise FileNotFoundError(
            f"同梱の python.rules が見つかりません: {pattern}")
    return hits[0]


RULES_FILENAME = "verify-tests.rules"

# 連結のときに同梱 python.rules から落とす規則。
#
# `#` 単体の SKIP_MUTATING_REST は、連結すると上の語境界付きの規則を無効にする。
# skipPos は当たった位置の**最小値**を採るので（mutator.py）、緩い方が必ず勝つ。
# **Python 向け規則を当てる唯一の対象 scripts/check_claude_hooks.sh の11行目が
# `if [[ $# -eq 0 ]]` で、落とさないとこの行の変異2件が消えたままになる**（実測）。
# 落としてもコメントの抑止は失われない。上の規則が両方の言語で同じ働きをする。
BUNDLED_RULES_DROPPED = ("# ==> SKIP_MUTATING_REST",)


def write_rules(tmpdir, include_python):
    """規則ファイルを1つ書き出し、そのパスを返す。

    **連結する。**`--only` は規則ファイルを1つしか受け取らない
    （genmutants.py の `rules = [parsed.only]`、実測で確認）。`--only` を使わない
    形はすべて universal.rules を巻き込むので、「当てる規則を増やすだけ」は
    現状の CLI では成立しない。
    """
    text = SHELL_RULES
    if include_python:
        with open(bundled_python_rules()) as f:
            kept = [ln for ln in f.read().splitlines()
                    if ln not in BUNDLED_RULES_DROPPED]
        text = text + "\n" + "\n".join(kept) + "\n"
    path = os.path.join(tmpdir, RULES_FILENAME)
    with open(path, "w") as f:
        f.write(text)
    return path


# ヒアドキュメントで Python を起動している行。`python3 - "$@" <<'PY'` の形。
#
# **`python3` の字面を探す形にはしない。**guard-unsandboxed-pytest.sh は
# `python3` を検出用の正規表現の中に持つだけで、ヒアドキュメントの中身は
# JSON である（実測）。字面で選ぶと純 shell の対象へ Python 向け規則が当たる。
# 同じ行の中で python の起動とヒアドキュメントの開始が繋がっていることを見る。
PY_HEREDOC_RE = re.compile(
    r"(?<![\w./-])python[0-9.]*(?![\w.])"
    r"[^<>\n]*<<(?P<dash>-?)\s*(?P<q>['\"]?)(?P<tag>\w+)(?P=q)"
)


def python_heredocs(text):
    """Python を起動しているヒアドキュメントを `(中身, 終端が在ったか)` で返す。

    `needs_python_rules` と `syntax_ok` がこの1つを共有する。判定を2つ持つと、
    Python 向け規則を当てる対象と Python の構文検査を掛ける対象がずれ、
    片方だけが効いている状態に気づけない。

    **終端の有無を返す。**同梱 python.rules の `(^\\s*)(\\S+.*\\n)` は行を丸ごと
    `pass` へ置き換えるので、終端の `PY` 自身を潰した変異体ができる（実測）。
    黙って「そこまでが本文」として返すと、`bash -n` も ast.parse も通ってしまう。
    ヒアドキュメントが末尾でない対象では、本文が後続の shell を飲み込む。
    """
    out = []
    rest = iter(text.splitlines())
    for line in rest:
        m = PY_HEREDOC_RE.search(line)
        if not m:
            continue
        tag = m.group("tag")
        dash = bool(m.group("dash"))   # `<<-` は終端の字下げ（タブ）を許す
        body = []
        closed = False
        # 同じ iterator を進める。終端の行はここで消費されるので、外側の
        # for は中身を読み直さずヒアドキュメントの次の行から再開する。
        for inner in rest:
            probe = inner.lstrip("\t") if dash else inner
            if probe == tag:
                closed = True
                break
            body.append(inner)
        out.append(("\n".join(body), closed))
    return out


def read_target(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def needs_python_rules(path):
    """その対象へ Python 向け規則も当てるかを、中身から機械的に決める。

    **対象ごとの手書きの一覧を持たない。**持つと対象が増減したときに規則の
    選び方が追随せず、shell 向け規則だけが当たって変異体が数件しか出ない状態が
    「変異体が1件以上」の門を通る。scripts/check_claude_hooks.sh は331行のうち
    316行が Python で、shell 向け規則の該当は `-eq` の1件だけだった（実測）。
    """
    try:
        return bool(python_heredocs(read_target(path)))
    except OSError:
        return False


def syntax_ok(path, is_python_heredoc):
    """変異体が構文として成立しているか。生成後・実行前の前段。

    通らない変異体を残すと、対象が動かないのでテストは必ず落ち、
    analyze_mutants は kill と数える。テストに判別力があったからではないのに
    点数が上がる。#16 が塞ごうとしている型そのもの。同梱規則の350件のうち
    72件が `bash -n` を通らなかった（実測）。

    **`bash -n` だけでは足りない。**クォート付きヒアドキュメント（`<<'PY'`）の
    中身を bash は構文解析しないので、Python として壊れた変異体がそのまま
    通過する（実測）。Python 向け規則を当てる対象では中身も ast.parse に掛ける。
    """
    proc = subprocess.run(["bash", "-n", path], capture_output=True, text=True)
    if proc.returncode != 0:
        return False
    if not is_python_heredoc:
        return True
    try:
        text = read_target(path)
    except OSError:
        return False
    for code, closed in python_heredocs(text):
        # 終端を潰した変異体をここで落とす。潰れたまま通すと、bash も Python も
        # 構文としては受け付けるのに、意味は原本と別物という変異体が残る。
        if not closed:
            return False
        try:
            ast.parse(code)
        except (SyntaxError, ValueError):
            return False
    return True


# --mutate が shell テストを同定する規約。**v1 の SH_PATTERNS とは別に持つ。**
# あちらへ足すと v1 の shell レーンの対象まで変わる。
#
# `*.bats` を #18 の移行より前から入れておく。移行で `.test.sh` が `.bats` へ
# 変わったときに規約を直し忘れると、18本が丸ごと網から消え、**判別力が落ちて
# いないことを確かめるはずの仕組みが、確かめる対象を失ったまま緑で通る。**
#
# **この規約はテストの同定にだけ使う。対象の同定には使わない。**テスト名から
# 対象名を機械的に作る形は18本中12本しか引けない（実測）。対象は本文の宣言から取る。
MUTATE_SH_PATTERNS = (r"^.*\.test\.sh$", r"^test_.*\.sh$", r"^.*\.bats$")

# --mutate の対象外。**v1 の SHELL_EXCLUDED とは外す理由が違うので別に持つ**
# （v1 は「隔離下で本来の挙動を測れない」1本だけ）。
# どちらも宣言は `none` なので、この集合が無くても対にはならない。要るのは
# 測っていない対象の一覧（受け入れ条件12）へ理由付きで載せるため。
MUTATE_SHELL_EXCLUDED = {
    "dot_claude/hooks/executable_settings-wiring.test.sh",
    "dot_claude/compact-plus-backend/executable_e2e-integration.test.sh",
}

# 分類の名前。報告の字面と検査の期待値をここ1箇所で持つ。
UNMEASURABLE = "計測できなかった"


class Unmeasurable(Exception):
    """「計測できなかった」で止めるべき事態。理由を1つ持つ。"""


# 宣言はテストの先頭に置く決まりなので、先頭のこの行数までしか見ない。
# **ファイル全体を走査しない。**走査すると、本文のヒアドキュメントで同じ字面を
# 引用しているだけのテストが、自分の宣言を持たないまま門を通る。
DECLARATION_HEAD_LINES = 30

DECLARATION_RE = re.compile(r"^#\s*mutation-target:\s*(.+?)\s*$")
# `none` には理由を要求する（受け入れ条件11）。
NONE_WITH_REASON_RE = re.compile(r"^none\s*\(\s*\S.*\)$")


def read_declaration(repo, test_rel):
    """shell テストの `# mutation-target:` を読み、対象のリポジトリ相対パスを返す。

    対象を持たないテスト（`none (<理由>)`）では None を返す。宣言が無い、
    書式が違う、宣言先が実在しない場合は Unmeasurable を投げる。
    **黙って読み飛ばさない。**読み飛ばすと、対象が抜けたまま検査済みに見える
    ——#16 が塞ごうとしている型そのものになる。

    理由を欠いた `none` も通さない。通すと、測らない判断が誰にも読めないまま
    対象集合から落ちる。
    """
    try:
        text = read_target(os.path.join(repo, test_rel))
    except OSError as e:
        raise Unmeasurable(f"{test_rel}: 読めない（{e}）")
    body = None
    for line in text.splitlines()[:DECLARATION_HEAD_LINES]:
        m = DECLARATION_RE.match(line)
        if m:
            body = m.group(1)
            break
    if body is None:
        raise Unmeasurable(f"{test_rel}: `# mutation-target:` の宣言が無い")
    if re.match(r"^none(?![\w./-])", body):
        if not NONE_WITH_REASON_RE.match(body):
            raise Unmeasurable(f"{test_rel}: `none` に理由が書かれていない")
        return None
    if len(body.split()) != 1:
        raise Unmeasurable(f"{test_rel}: 宣言先がパス1つではない（{body}）")
    if os.path.isabs(body) or os.path.normpath(body).startswith(".."):
        raise Unmeasurable(
            f"{test_rel}: 宣言先はリポジトリのルートからの相対で書く（{body}）")
    if not os.path.isfile(os.path.join(repo, body)):
        raise Unmeasurable(f"{test_rel}: 宣言先が実在しない（{body}）")
    return body


def shell_tests(tracked):
    """同定の規約に当たる追跡ファイルを返す。"""
    return sorted(p for p in tracked
                  if match_any(os.path.basename(p), MUTATE_SH_PATTERNS))


def shell_pairs(repo, tracked):
    """宣言を1回走査し、3つの入れ物を持つ dict で返す。

    - `pairs` … shell レーンの対（対象、テストコマンドを導けるテストのパス）
    - `python_pairs` … 対象が `.py` の対。shell レーンの対ではなく、Python レーンの
      `test-command` に含めるテストを決めるために使う（受け入れ条件6）。同じ走査
      から出す。別に走査を書くと、宣言の読み方が2つになってずれる
    - `unmeasurable` … （テストのパス、理由）の対。宣言が無い・書式が違う・
      宣言先が実在しないテスト

    **1本の失敗でリポジトリ全体を止めない。**「計測できなかった」は分類も
    `--update-baseline` の単位も対象なので、粒度をそちらへ揃える（spec の
    識別子衝突の節）。止める形にすると、#18 が18本を `.bats` へ改名する作業で
    1本だけ宣言を引き継ぎ忘れたときに、残りの対の安全網まで丸ごと消える。
    宣言を欠いたテストは対を1つ寄与しないだけで、残りの対象は確定している。

    **測れなかったテストの名前を返り値へ含める。**含めないと、後段が
    「宣言が消えて対象が落ちた」と「もともとその対象が無い」を区別できず、
    `--update-baseline` が既存の基準を静かに刈る経路ができる。

    **宣言そのものは18本すべてへ要求する。**対象外の本の宣言を読まない形に
    すると、外す理由が本文から消えても気づけない。

    **プランが書いた戻り値の型（`list[tuple[str, str]]`）から広げてある。**
    上の2つは対の一覧だけでは表せない。
    """
    pairs, py_pairs, bad = [], [], []
    for test_rel in shell_tests(tracked):
        try:
            target = read_declaration(repo, test_rel)
        except Unmeasurable as e:
            bad.append((test_rel, str(e)))
            continue
        if target is None or test_rel in MUTATE_SHELL_EXCLUDED:
            continue
        if target.endswith(".py"):
            py_pairs.append((target, test_rel))
            continue
        pairs.append((target, test_rel))
    return {"pairs": pairs, "python_pairs": py_pairs, "unmeasurable": bad}


# cosmic-ray の設定の置き場。**リポジトリごとにちょうど1つ。**2つ在れば止める。
# penguinEx は `pyproject.toml` を持つのでそこへ、chezmoi は持たないので
# `.cosmic-ray.toml` を別に置く（chezmoi はソースディレクトリのドット始まりを
# 配置対象にしないので `.chezmoiignore` への追記は要らない）。
#
# **cosmic-ray が読む形そのままで置く。**`load_config` は
# `toml.loads(...)["cosmic-ray"]` なので（`cosmic_ray/config.py`、実測）、表は
# `[tool.cosmic-ray]` ではなくトップレベルの `[cosmic-ray]` に置く。道具の側で
# 読み替えて一時ファイルへ書き出す形は採らない。**門が数える設定と cosmic-ray が
# 実際に読む設定が同じ1つのファイルであることが、「門は通ったのに走行は別の
# 対象を測っていた」を原理的に起こさない。**
MUTATION_CONFIG_NAMES = ("pyproject.toml", ".cosmic-ray.toml")
MUTATION_CONFIG_TABLE = "cosmic-ray"


def mutation_config(repo):
    """`(設定ファイルのリポジトリ相対パス, `[cosmic-ray]` の表)` を返す。

    どの候補にも表が無ければ Unmeasurable。**黙って既定値で走らない。**
    設定を欠いたまま走ると `module-path` が無いので対象0本になり、
    「生き残り0件＝判別力が満点」と見分けが付かなくなる。

    **2つの候補が両方とも表を持っていても Unmeasurable。**先に当たったほうを
    採って残りを黙って無視すると、「片方だけ直したのに効かない」型の穴が開く。
    無視された側を読んだ人には、対象集合も `test-command` も自分が書いたとおりに
    見える。cosmic-ray 自身は設定ファイルを1つしか受け取らないので、
    2つ在る状態はどちらが走るかを設定から読めない状態でもある。
    """
    import tomllib
    hits = []
    for name in MUTATION_CONFIG_NAMES:
        path = os.path.join(repo, name)
        if not os.path.isfile(path):
            continue
        try:
            with open(path, "rb") as f:
                conf = tomllib.load(f)
        except (OSError, tomllib.TOMLDecodeError) as e:
            raise Unmeasurable(f"{name}: TOML として読めない（{e}）")
        if MUTATION_CONFIG_TABLE in conf:
            hits.append((name, conf[MUTATION_CONFIG_TABLE]))
    if len(hits) > 1:
        raise Unmeasurable(
            f"cosmic-ray の設定（`[{MUTATION_CONFIG_TABLE}]` の表）が"
            f"2つ以上ある（{' / '.join(n for n, _ in hits)}）。"
            "どちらが走るかを設定から読めないので、1つに寄せる")
    if not hits:
        raise Unmeasurable(
            f"cosmic-ray の設定（`[{MUTATION_CONFIG_TABLE}]` の表）が "
            f"{' / '.join(MUTATION_CONFIG_NAMES)} のどれにも無い")
    return hits[0]


def _glob_rel(root, pattern):
    """`cosmic_ray.modules` と同じ広げ方で、root からの相対パスの集合を作る。

    `find_modules` は `glob.glob(f"{module_path}/**/*.py", recursive=True)`、
    `filter_paths` は `glob.glob(excluded_path, recursive=True)`
    （どちらも `cosmic_ray/modules.py`、実測）。**同じ形で書く。**別の広げ方を
    すると、門が数えた集合と cosmic-ray が実際に変異させた集合がずれ、
    ずれた分は誰にも見えないまま測られずに終わる。
    """
    return {os.path.normpath(p)
            for p in glob.glob(pattern, root_dir=root, recursive=True)}


def py_classification(repo, sandbox):
    """Python レーンの対象集合を作業コピーの上で数え、4つの入れ物で返す。

    - `config` … 読んだ設定ファイルのリポジトリ相対パス
    - `targets` … cosmic-ray が拾う `.py`（`module-path` から `excluded-modules` を引いたもの）
    - `excluded` … `excluded-modules` が実際に落とした `.py`
    - `tracked_py` … 追跡されている `.py` すべて
    - `gap` … 追跡 `.py` のうち、拾われも除外もされていないもの

    **作業コピーの上で数える。**`make_worktree_copy` が先に呼ばれていることが
    前提になる。ソースツリーの上で数えると追跡外の `.py` まで glob に入り、
    数えた集合と、追跡ファイルだけの作業コピーで実際に測る集合が食い違う。
    """
    name, conf = mutation_config(repo)
    host = os.path.join(sandbox, WORKTREE_COPY_NAME)
    if not os.path.isdir(host):
        raise Unmeasurable("作業コピーが無いまま Python レーンの対象を数えようとした")
    paths = conf.get("module-path")
    if isinstance(paths, str):
        paths = [paths]
    if not paths:
        raise Unmeasurable(f"{name}: `module-path` が空")
    picked = set()
    for rel in paths:
        # **`.py` の名指しを通さない。**cosmic-ray 自身は単一ファイルも受けるが、
        # 名指しの一覧は新しく置いた `.py` が足されない限り黙って対象外になる。
        # 測られていないのに緑で通るので、この設計が塞ごうとしている型の穴が
        # 対象の決め方そのものに開く（受け入れ条件2）。
        if rel.endswith(".py"):
            raise Unmeasurable(
                f"{name}: `module-path` はディレクトリで並べる。"
                f"対象にしたいファイルを名指ししない（{rel}）")
        # **絶対パスと親をさかのぼるパスを通さない。**cosmic-ray は設定に書かれた
        # パスをそのまま `module_path` に載せるので、絶対で書くと変異体の識別子に
        # この機械の場所が焼き付き、`mutant_id` が全件を「計測できなかった」へ落とす。
        if os.path.isabs(rel) or os.path.normpath(rel).startswith(".."):
            raise Unmeasurable(
                f"{name}: `module-path` はリポジトリのルートからの相対で書く（{rel}）")
        if not os.path.isdir(os.path.join(host, rel)):
            # `find_modules` は実在しない `module-path` で FileNotFoundError を
            # 投げ、`cosmic-ray init` は終了コード66で落ちる（実測）。ここで
            # 先に止めるのは、原因の読める理由を付けるため。
            raise Unmeasurable(
                f"{name}: `module-path` が作業コピーに無い（{rel}）")
        picked |= _glob_rel(host, f"{rel}/**/*.py")
    excluded = set()
    for pattern in conf.get("excluded-modules", ()):
        excluded |= _glob_rel(host, pattern)
    tracked = tracked_files(repo, sandbox)
    if tracked is None:
        raise Unmeasurable("git ls-files が失敗した")
    tracked_py = {p for p in tracked if p.endswith(".py")}
    targets = picked - excluded
    return {
        "config": name,
        "targets": sorted(targets),
        "excluded": sorted(excluded),
        "tracked_py": sorted(tracked_py),
        "gap": sorted(tracked_py - targets - excluded),
    }


def py_target_set(repo, sandbox):
    """cosmic-ray が拾う `.py` の集合。"""
    return set(py_classification(repo, sandbox)["targets"])


def completeness_gap(repo, sandbox):
    """追跡 `.py` のうち、拾われも除外もされていないもの。

    **`module-path` の手書きの一覧そのものに開く穴を塞ぐ。**一覧に無い新しい
    ディレクトリへ置かれた `.py` は、名指しの一覧と同じように黙って対象外になる。
    1本でもあれば「計測できなかった」で止める側が呼ぶ（受け入れ条件5）。
    """
    return set(py_classification(repo, sandbox)["gap"])


# 変異体の識別子は `(対象のリポジトリ相対パス, 行番号, 変異後のその行の内容)`。
# **道具が振る通し番号を使わない。**cosmic-ray の `job_id` は `init` のたびに
# 生成される UUID でセッションをまたいで一致せず、universalmutator の
# `check-issues.mutant.99.sh` の番号は生成順なのでルールを1つ足すと全部ずれる。
# どちらを使っても基準との比較が毎回全件不一致になり、「判別力が落ちた」と
# 「番号がずれた」が区別できなくなる。


def mutant_id(path, line, content):
    """両レーン共通の変異体の識別子を返す。

    **書式を1箇所で決める。**レーンごとに組み立てると、両方の形が揃っている
    ことを外から確かめる手立てが無くなり、基準ファイルがレーンを区別せずに
    読めるという前提が静かに崩れる。

    `content` からは行末の改行だけを落とす。字下げや空白まで正規化すると、
    別々の変異体が同じ識別子へ潰れて衝突が増える。
    """
    if not isinstance(line, int) or isinstance(line, bool) or line < 1:
        raise Unmeasurable(f"{path}: 行番号が1以上の整数でない（{line!r}）")
    if not path:
        raise Unmeasurable("対象のパスが空")
    # **絶対パスと親をさかのぼるパスを通さない。**通すと基準にその機械や
    # ワークツリーの場所が焼き付き、別の場所で走らせた瞬間に全識別子が
    # 食い違って、生き残りが全件「基準に無い」へ落ちる。
    if os.path.isabs(path):
        raise Unmeasurable(f"識別子の対象は相対パスで持つ（{path}）")
    norm = os.path.normpath(path)
    # **前方一致で `..` を弾かない。**`..hidden.sh` のような正当な名前が
    # 巻き添えになり、その対象が丸ごと「計測できなかった」へ落ちる。
    # 親をさかのぼるのは `..` そのものと `../` で始まる形だけ。
    if norm == ".." or norm.startswith(".." + os.sep):
        raise Unmeasurable(f"識別子の対象はリポジトリの内側で持つ（{path}）")
    body = content.rstrip("\r\n")
    if "\n" in body or "\r" in body:
        raise Unmeasurable(f"{norm}: 識別子の内容が1行になっていない")
    return (norm, line, body)


HUNK_RE = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@")


def added_line_at(diff, line):
    """統一差分の中で、新しいファイルの `line` 行目にあたる追加行を返す。

    **`+` で始まる行を字面で数えて先頭を採らない。**1件の変異で `+` 行が
    2本出ることが実際にある（実測で 2,440件中4件。`sys.exit(0)` の変異に
    ファイル末尾の空行が巻き込まれる形）。先頭を採ると、当たった行が2本目の
    ときに別の行の内容を識別子にする。どちらを採るかを決めておかないと
    衝突判定も基準の比較もぶれるので、**ハンクの見出しから行を数えて
    `start_pos[0]` に一致する追加行だけを採る。**

    表題（`--- a/x` と `+++ b/x`）は最初のハンクより前にあるので、行番号を
    数え始める前に読み飛ばされる。字面で `+++` を落とす形にはしない。
    本文が `++` で始まる行を取り違える。

    実測ではハンクの前後で行数が変わったことは一度も無い（2,440件）ので、
    新旧どちらで数えても同じ行に落ちる。新しい側で数えるのは、識別子が
    持つのが変異「後」の行だから。
    """
    newno = None
    for raw in diff.splitlines():
        m = HUNK_RE.match(raw)
        if m:
            newno = int(m.group(1))
            continue
        if newno is None:
            continue
        if not raw:
            newno += 1
            continue
        tag, rest = raw[0], raw[1:]
        if tag == "-":
            continue
        if tag == "\\":
            # `\ No newline at end of file`。どちらの側の行でもない。
            continue
        if tag == "+":
            if newno == line:
                return rest
            newno += 1
            continue
        newno += 1
    return None


# 変異を当てる段で例外が出たときの結果の形。cosmic-ray は
# `WorkResult(test_outcome=INCOMPETENT, worker_outcome=EXCEPTION)` を返し、
# **`diff` は既定の `None` のまま**になる（`cosmic_ray/mutating.py` の except 節と
# `work_item.py` の WorkResult の既定値で確認）。8.7.0 の `core/ExceptionReplacer` が
# ドット付きの例外名でこれを起こす。
WORKER_OK = "normal"

# フィルタが落とした記録の目印。**cosmic-ray 8.7.0 のフィルタ4つ
# （`tools/filters/` の operators / git / line / pragma）はすべて
# `WorkerOutcome.SKIPPED` を書く**（venv の実物で確認）。
WORKER_FILTERED = "skipped"

# 行にならなかった記録の種別。**3つを区別して数えられる形で返す。**
# まとめて「行にならなかった」で返すと、フィルタが落とした正当な分と、
# 道具が測れなかった分と、まだ走っていない分が同じ数に混ざる。門はそれぞれで
# 別の判断をする（フィルタ分は件数の照合にだけ効き、残る2つは走行を止める）。
#
# **`filtered` は「フィルタの目印がある」ことで決める。「`test_outcome` が無い」
# ことで決めない。**排除による定義にすると、道具の失敗が無害な側へ化ける。
# 8.7.0 には `test_outcome` を書かない producer がフィルタ以外に2つある
# （どちらも venv の実物で確認）。
#
# - `mutating.py` の `WorkerOutcome.NO_TEST` … 変異を当てられなかったとき。
#   **local distributor で到達する**（この設計が使う唯一の distributor）
# - `distribution/http.py` の `WorkerOutcome.ABNORMAL` … 結果の取得で例外
#
# どちらも無害として素通しすると、行が減っても件数の照合は満たすので等式でも
# 捕まらない。`init` と `exec` の間で対象が動いた走行が満点になる。
SKIPPED_PENDING = "pending"      # 結果がまだ無い（`[work item, null]`）
SKIPPED_FILTERED = "filtered"    # フィルタが落とした（`worker_outcome` が skipped）
SKIPPED_BROKEN = "broken"        # 道具がその変異体を測れなかった


def ids_from_cosmic_ray(dump_json):
    """`cosmic-ray dump` の出力を読み、`(rows, skipped)` を返す。

    `rows` の1行は `(識別子, 生き残りか, test_outcome, worker_outcome)`。
    `skipped` の1件は `(種別, test_outcome, worker_outcome)` で、行にならなかった
    記録が**1件残らず**ここに載る。

    **結果の種別を識別子と一緒に返す。**返さないと Task 7 の門が同じ dump を
    もう一度自前で読むことになり、読み手が2つに育つ。育つと「門は通っているのに
    識別子側の解釈が違う」という食い違いが起きえて、そのとき片方は必ず黙っている。

    **行にならなかった記録も返す。**Ruling 15 は `incompetent` の読み飛ばしを
    「Task 7 の門が必ず捕まえる」ことで正当化していたが、行にしない以上
    門の目には入らず、**捕まっていなかった。**`skipped` に載せることで、
    (1) 変異の適用そのもので落ちた `incompetent` を門が捕まえられるようになり、
    (2) `init` が作った件数と `len(rows) + len(skipped)` を突き合わせられる。
    突き合わせが要るのは、`exec` が途中で死んだセッションでも走り終えた分だけで
    「測れた」ように見えるため。**変異体が減って生き残りが0に見える**という、
    #16 が塞ごうとしている型そのもの。

    `dump_json` は `cosmic-ray dump` の標準出力そのもの。1行が
    `[work item, 結果]` の2要素配列という JSON Lines である。

    **`module_path` と `start_pos` は `mutations` 配列の中から読む。**
    work item のトップレベルには無い（cosmic-ray 8.7.0 で実測）。

    **変異を自前で当て直さない。**変異後の行は `diff` の追加行から取れる。
    当て直すと、cosmic-ray が実際に実行した変異体と識別子が食い違いうる。

    `test_outcome` が無い記録は行を作らない。`cr-filter-operators` で落とした
    変異体がこの形になる（`worker_outcome` が `skipped`、`diff` は `null`）。
    生き残り側へ数えると基準がぶれ、kill 側へ数えると測っていない変異体で
    点数が上がる。**ただしフィルタ扱いにするのは目印がある分だけ**
    （`WORKER_FILTERED` の注記）。

    **道具が測れなかった記録と、出力が壊れている記録を分ける。**
    `worker_outcome` が `normal` でない記録（変異の適用で落ちた `exception` など）
    は、識別子を作れなくても行にせず `skipped` へ回す。止める形にすると、
    Python レーンはリポジトリ単位の1セッションなので**その1件でリポジトリの
    Python 対象すべてが「計測できなかった」へ落ちる。**この形は道具の不具合で
    現に出る。二重に止めると「道具が測れなかった」と「出力が壊れている」が
    同じ扱いになり、原因も次の一手も違うものが混ざる。

    `worker_outcome` が `normal` なのに識別子を作れない記録では止まる。
    黙って捨てると、その変異体が生き残っていても基準に載らない。
    #16 が塞ごうとしている型そのもの。
    """
    out, skipped = [], []
    for raw in dump_json.splitlines():
        raw = raw.strip()
        if not raw:
            continue
        try:
            rec = json.loads(raw)
        except ValueError as e:
            raise Unmeasurable(f"cosmic-ray dump を JSON Lines として読めない（{e}）")
        if not isinstance(rec, list) or not rec:
            raise Unmeasurable("cosmic-ray dump の1行が [work item, 結果] の形でない")
        work = rec[0]
        result = rec[1] if len(rec) > 1 else None
        if result is None:
            skipped.append((SKIPPED_PENDING, None, None))
            continue
        outcome = result.get("test_outcome")
        worker = result.get("worker_outcome")
        if outcome is None:
            # **フィルタの目印があるときだけフィルタと呼ぶ。**「`test_outcome` が
            # 無い」で決めると、変異を当てられなかった記録（`no-test`）や
            # 結果を取れなかった記録（`abnormal`）が無害な側へ化ける。
            kind = (SKIPPED_FILTERED if worker == WORKER_FILTERED
                    else SKIPPED_BROKEN)
            skipped.append((kind, None, worker))
            continue
        broken = worker != WORKER_OK

        def stop(why):
            """出力が壊れているときだけ止める。道具が落ちた分は `skipped` へ回す。"""
            if broken:
                skipped.append((SKIPPED_BROKEN, outcome, worker))
                return None
            raise Unmeasurable(why)

        muts = work.get("mutations") or []
        if len(muts) != 1:
            stop(f"1つの work item に変異が{len(muts)}件あり、行を1つに定められない")
            continue
        m = muts[0]
        module_path = m.get("module_path")
        start = m.get("start_pos") or []
        if not module_path or not start:
            stop("cosmic-ray dump の mutations に module_path か start_pos が無い")
            continue
        line = start[0]
        diff = result.get("diff")
        if not diff:
            stop(f"{module_path}:{line}: 結果はあるのに diff が無く、"
                 "変異後の行を取れない")
            continue
        content = added_line_at(diff, line)
        if content is None:
            stop(f"{module_path}:{line}: diff にその行の追加行が無い")
            continue
        out.append((mutant_id(module_path, line, content),
                    outcome == "survived", outcome, worker))
    return out, skipped


# 判別力を測れた `test_outcome`。**この2つ以外はすべて「測れなかった」側。**
#
# **正の形で列挙する。**「`incompetent` なら測れていない」と書くと、道具が別の
# 名前で失敗を返すようになった分が黙って測れた側へ入る。門は測れなかった分が
# 1件でもあれば止めるので、判定を字面の否定に置くと、その字面を知らない失敗が
# そのまま満点へ通る。**閾値は0のまま動かさない。**`core/ExceptionReplacer` を
# 対象から外してあるのは対象の側の話で、この閾値を緩めるためではない。
MEASURED_OUTCOMES = ("survived", "killed")


def python_lane_gate(dump_json, init_count, unmutated_rc):
    """Python レーンの走行の結果を信じてよいかを見る。信じられない理由を1つ返す。

    問題が無ければ None。返す文字列は「計測できなかった」に続ける理由で、
    先頭の分類名は付けない（呼び出し側が `UNMEASURABLE` と組み立てる）。

    **終了コードを見ない。**cosmic-ray は測れていない走行を軒並み0で返す。
    `test-command` が実在しない実行ファイルのとき、`init` も `baseline` も
    `exec` も0で終わり、`cr-rate --fail-over 0` は生存率 0.00 を返して0で
    終わる（実測）。**生き残り0件は「判別力が満点」と同じ字面**なので、
    終了コードに依存した門は、測っていない走行を最良の成績として通す。
    見るのは `test_outcome` と、変異体が何件作られたか。

    `unmutated_rc` は変異を当てない状態で `test-command` を走らせた終了コード。
    **`cosmic-ray baseline` の終了コードを渡してはいけない。**あれは
    `test-command` が起動できなくても0を返す。渡す側がそれを取り違えても
    「測れなかった記録」の側で捕まるようにしてある。

    `init_count` は `cosmic-ray init` が作った work item の件数。
    **実在しないパスを与えたときの終了コード66とは別の話。**あれは `init` が
    落ちる形で、ここで見たいのは「実在するが変異体が1件も出ない」形
    （`.py` を含まないディレクトリ、全件が `excluded-modules` に入っている）。
    `py_target_set` は対象0本を空集合としてそのまま返すので、止めるのは門の側。

    dump は `ids_from_cosmic_ray` に読ませる。**自前で読み直さない。**
    読み手が2つに育つと、門は通っているのに識別子側の解釈が違うという
    食い違いが起きえて、そのとき片方は必ず黙っている。

    **測れた記録を正の形で定め、それ以外を全部数える。**行と `skipped` の
    両方を見る。cosmic-ray が変異の適用そのもので例外を出した経路
    （`worker_outcome=exception`、`diff` は `None`）は識別子を作れないので
    行にならない。行だけを見る門はこの経路を1件も捕まえない。実測でこの形は
    出る（`except (ValueError, os.error):` のような**組の中の**ドット付き
    例外名で `core/ExceptionReplacer` が落ちる）。

    `incompetent` という字面で数えない。字面で数えると、`no-test` や
    `abnormal` のように `test_outcome` を持たない失敗が素通しになる。

    **件数を突き合わせる。**`init` が作った件数と `len(rows) + len(skipped)` が
    一致すること。一致しなければ、dump に現れていない work item がある。
    合成ではなく実物の走行で成立することを確かめてある（変異体31件の合成
    プロジェクトで、フィルタ有無 × `exec` 有無の4通り。行30 + 壊れ1 /
    行29 + フィルタ2 / 未実行31 / 未実行29 + フィルタ2）。
    """
    if isinstance(init_count, bool) or not isinstance(init_count, int):
        return f"cosmic-ray init が作った変異体の件数が整数でない（{init_count!r}）"
    if init_count < 1:
        return ("cosmic-ray init が変異体を1件も作らなかった"
                "（対象の `.py` が1本も無いか、全件が除外に入っている）")
    if isinstance(unmutated_rc, bool) or not isinstance(unmutated_rc, int):
        return f"変異を当てない走行の終了コードが整数でない（{unmutated_rc!r}）"
    if unmutated_rc != 0:
        return ("変異を当てない状態で test-command が落ちる"
                f"（終了コード {unmutated_rc}）。"
                "赤いテストは変異体を残らず kill するので満点になる")
    rows, skipped = ids_from_cosmic_ray(dump_json)
    # 行のうち、測れたと言えないもの。**`worker_outcome` も見る。**片方だけを
    # 見ると、道具が異常を申告した記録が判別力の数へ入る。
    stalled = [(k, outcome, worker) for k, _survived, outcome, worker in rows
               if worker != WORKER_OK or outcome not in MEASURED_OUTCOMES]
    # 行にならなかったうち、フィルタでも未実行でもないもの。
    crashed = [(None, outcome, worker) for kind, outcome, worker in skipped
               if kind == SKIPPED_BROKEN]
    if stalled or crashed:
        shown = "、".join(sorted({f"{o or 'なし'}/{w or 'なし'}"
                                 for _, o, w in stalled + crashed}))
        where = (f"、最初の1件は {stalled[0][0][0]}:{stalled[0][0][1]}"
                 if stalled else "")
        return (f"判別力を測れなかった変異体が{len(stalled) + len(crashed)}件ある"
                f"（test_outcome/worker_outcome は {shown}{where}）。"
                "生き残りにも kill にも数えられないので成績が上振れる")
    waiting = [s for s in skipped if s[0] == SKIPPED_PENDING]
    if waiting:
        return (f"結果がまだ無い変異体が{len(waiting)}件ある"
                "（exec が最後まで走っていない）。走り終えた分だけで成績を出すと、"
                "測っていない変異体が数からも消える")
    seen = len(rows) + len(skipped)
    if seen != init_count:
        return (f"cosmic-ray init が作った変異体は{init_count}件なのに、"
                f"dump にある記録は{seen}件で食い違う")
    if not rows:
        return (f"cosmic-ray init が作った{init_count}件がすべて"
                "行にならず、判別力を測れた変異体が1件も無い")
    return None


def ids_from_universalmutator(target, mutant_path, repo=None):
    """変異体と対象の差分から識別子を作る。

    **変異体のファイル名を識別子に入れない。**universalmutator が振る
    `check-issues.mutant.99.sh` の番号は生成順なので、ルールを1つ足すと全部ずれる。

    `target` は識別子に載せるパスそのもの（リポジトリのルートからの相対）。
    `repo` を渡すとファイルはその下から読む。渡さないときは `target` を
    そのまま開く。**識別子に載る値は `repo` の有無で変わらない。**

    行数が変わった変異体と、変更が1行でない変異体では止まる。
    universalmutator は1行だけを書き換える（実測で行数も不変）ので、
    そうでないなら生成か読み取りが壊れている。片方を黙って選ぶと、
    選ばなかった側の変更が識別子から消える。
    """
    source = os.path.join(repo, target) if repo else target
    try:
        original = read_target(source).splitlines()
        mutant = read_target(mutant_path).splitlines()
    except OSError as e:
        raise Unmeasurable(f"{target}: 対象か変異体を読めない（{e}）")
    if len(original) != len(mutant):
        raise Unmeasurable(
            f"{target}: 変異体の行数が対象と違う（{len(original)} → {len(mutant)}）")
    changed = [(i + 1, mutant[i])
               for i in range(len(original)) if original[i] != mutant[i]]
    if len(changed) != 1:
        raise Unmeasurable(
            f"{target}: 変異体の変更行が1行でない（{len(changed)}行）")
    line, content = changed[0]
    return mutant_id(target, line, content)


def group_by_target(pairs):
    """識別子の対を対象ごとにまとめ、衝突した対象を「計測できなかった」へ落とす。

    返すのは3つの入れ物を持つ dict。

    - `targets` … 測れた対象の一覧。**生き残り0件の対象もここに載る。**
      載せないと「判別力が満点だった対象」と「基準にまだ記録が無い対象」が
      区別できない
    - `survivors` … 対象ごとの生き残りの識別子
    - `unmeasurable` … （対象、理由）の対

    **同じ識別子が2件以上に当たったら、その対象ごと落とす。**衝突した識別子
    だけを判定から外して残りで基準を書く形は採らない。その対象の kill 集合が
    確定しないので、残りの識別子だけで差分を取ると「衝突した1件が実は
    生き残っていた」を見逃す。「計測できなかった」は分類も `--update-baseline`
    の単位も対象なので、粒度をそちらへ揃える。

    **生き残りかどうかを衝突の判定に持ち込まない。**両方が生き残りでも、
    識別子が基準の鍵として一意でないことは変わらない。
    """
    counts, survivors = {}, {}
    for row in pairs:
        # **行の先頭2つだけを読む。**Python レーンは結果の種別まで持った
        # 長い行を渡す（`ids_from_cosmic_ray`）。shell レーンは対で渡す。
        # 幅を固定すると、片方のレーンがここを通れなくなる。
        ident, survived = row[0], row[1]
        path, line, content = ident
        key = (path, line, content)
        counts.setdefault(path, {})
        counts[path][key] = counts[path].get(key, 0) + 1
        survivors.setdefault(path, [])
        if survived:
            survivors[path].append(key)
    targets, kept, bad = [], {}, []
    for path in sorted(counts):
        dups = sorted(k for k, n in counts[path].items() if n > 1)
        if dups:
            # **全件を出す。**打ち切ると、残りの識別子の実体を人が見られない。
            # 受け入れ条件28が求めているのは「衝突した識別子が報告に出る」こと
            # であって、何件あったかではない。
            shown = "、".join(f"{line} 行目: {content}"
                             for _, line, content in dups)
            bad.append((path,
                        f"{path}: 同じ識別子が2件以上の変異体に当たった"
                        f"（{len(dups)}件: {shown}）"))
            continue
        targets.append(path)
        kept[path] = sorted(survivors[path])
    return {"targets": targets, "survivors": kept, "unmeasurable": bad}


def make_sandbox_home():
    """使い捨ての HOME を作り、合成フィクスチャを1つ置く。

    bwrap の --tmpfs /tmp はサンドボックス内の /tmp を差し替えるだけなので、
    HOME に使う実体はホスト側に置く。
    """
    sb = tempfile.mkdtemp(prefix=SANDBOX_PREFIX)
    os.makedirs(
        os.path.join(sb, ".claude", "projects", FIXTURE_PROJECT, "memory"),
        exist_ok=True,
    )
    return sb


def build_bwrap(repo, sandbox, extra_ro=()):
    """ホスト全体を読み取り専用にし、HOME だけを書き込み可能に戻す。

    --ro-bind で HOME を被せてはいけない。Read-only file system で
    HOME 配下への書き込みがすべて失敗する。
    """
    home = os.path.expanduser("~")
    argv = [
        "bwrap",
        "--ro-bind", "/", "/",
        "--dev", "/dev", "--proc", "/proc", "--tmpfs", "/tmp",
        "--bind", sandbox, home,
    ]
    for p in RO_BINDS:
        if os.path.exists(p):
            argv += ["--ro-bind", p, p]
    argv += ["--ro-bind", repo, repo]
    common = git_common_dir(repo)
    if common and os.path.exists(common) and not common.startswith(repo + os.sep):
        argv += ["--ro-bind", common, common]
    for src, dst in extra_ro:
        argv += ["--ro-bind", src, dst]
    argv += ["--chdir", repo, "--"]
    return argv


def run_cmd_in_sandbox(repo, sandbox, cmd, extra_ro=(), selftest=False):
    """サンドボックスの内側で1つのコマンドを走らせる。

    git ls-files もここを通す。外側で走らせると、対象を数えた環境と
    走らせる環境が食い違い、片方にしか無いファイルを見落とす。

    selftest は「この1回は人が明示的に頼んだ走行だ」という印で、`--` の口だけが
    立てる。R1 / R2 / R3 の走行では必ず落とす。落とさずに素通しすると、
    自テストが起動する verify-tests がこの印を受け継ぎ、その内側の pytest が
    また自テストを走らせて際限なく入れ子になる。落としてあるので、入れ子は
    「明示の1回」から数えて1段で止まる。
    """
    argv = build_bwrap(repo, sandbox, extra_ro) + list(cmd)
    env = dict(os.environ)
    env["VERIFY_TESTS_SANDBOX"] = "1"
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    if selftest:
        env["VERIFY_TESTS_SELFTEST"] = "1"
    else:
        env.pop("VERIFY_TESTS_SELFTEST", None)
    proc = subprocess.run(argv, capture_output=True, text=True, env=env)
    return proc.returncode, proc.stdout, proc.stderr


def sandbox_started(repo, sandbox):
    """bwrap の起動そのものが失敗したかを、終了コード以外で見る。

    bwrap は起動に失敗したとき終了コード1を返し、これは pytest の
    「テストが落ちた」と同じ値になる。区別を付けないと、隔離が一度も
    働いていないのに「テストが落ちた」と報告することになる。
    """
    rc, out, _ = run_cmd_in_sandbox(
        repo, sandbox, ["sh", "-c", f"printf ok > {MARKER}; cat {MARKER}"]
    )
    return rc == 0 and out.strip() == "ok"


def tracked_files(repo, sandbox):
    rc, out, _ = run_cmd_in_sandbox(repo, sandbox, ["git", "ls-files"])
    if rc != 0:
        return None
    return [ln for ln in out.splitlines() if ln.strip()]


# サンドボックスの HOME の中に作る作業コピーの名前。
WORKTREE_COPY_NAME = "verify-tests-worktree"


def make_worktree_copy(repo, sandbox):
    """追跡ファイルだけの書き込み可能な作業コピーをサンドボックスの中に作る。

    **変異は対象ファイルを実際に書き換える。**読み取り専用 bind の上では走らず、
    かといってソースツリーの上で走らせると、道具が途中で落ちたときに変異した
    ファイルがそのまま残る（cosmic-ray exec を外から止めると最後に当てた変異が
    対象ファイルへ残ることを実測で確認済み）。chezmoi 側でそれが起きると
    auto-apply が本番へ運ぶ（issue #22）。

    返すのは**サンドボックスの内側から見たパス**。ホスト側の実体は
    `os.path.join(sandbox, WORKTREE_COPY_NAME)` で、`--bind <sandbox> $HOME` に
    よって内側では `$HOME/<名前>` として見える。走らせる側が必要とするのは
    内側のパスなので、そちらを返す。

    `git ls-files` は読み取り専用 bind 側（対象リポジトリそのもの）で走らせる。
    tar で流すので実行ビットは保たれる（実測）。

    道具が書くもの（cosmic-ray の sqlite、universalmutator の変異体ディレクトリと
    killed.txt / notkilled.txt）も同じサンドボックスの HOME へ置ける。後片付けは
    呼び出し側が sandbox ごと消せば済む。

    作れなければ None を返す（tracked_files と同じ形）。
    """
    inside = os.path.join(os.path.expanduser("~"), WORKTREE_COPY_NAME)
    # pipefail を立てる。立てないと git ls-files が失敗しても後段の tar が成功する。
    script = ('set -o pipefail\n'
              'mkdir -p "$1" || exit 1\n'
              'git ls-files -z | tar --null -T - -cf - | tar -xf - -C "$1"\n')
    rc, _, _ = run_cmd_in_sandbox(
        repo, sandbox, ["bash", "-c", script, "bash", inside])
    if rc != 0:
        return None
    # **終了コードだけでは足りない。**pipefail が守るのは `git ls-files` が
    # 失敗した場合だけで、成功して0行を返した場合は空の入力を受けた tar が
    # 両段とも rc=0 で終わる（GNU tar は空の `-T` を拒まない。実測で確認）。
    # 空の作業コピーを「作れた」として返すと、対象0本の走行と
    # 「変異体が1件も生き残らなかった」が見分けられない。#16 が塞ごうとして
    # いるのがまさにその型なので、数えるところまでを成立の条件にする。
    tracked = tracked_files(repo, sandbox)
    if not tracked:
        return None
    return inside if _count_copied(sandbox) == len(tracked) else None


def _count_copied(sandbox):
    """作業コピーのホスト側の実体に在るものを数える。

    シンボリックリンクの張られたディレクトリは辿らずに1つとして数える。
    辿ると対象の外を歩き、数が追跡ファイルの数と合わなくなる。
    """
    host = os.path.join(sandbox, WORKTREE_COPY_NAME)
    n = 0
    for root, dirs, names in os.walk(host):
        n += len(names)
        links = [d for d in dirs if os.path.islink(os.path.join(root, d))]
        n += len(links)
        dirs[:] = [d for d in dirs if d not in links]
    return n


def collected_files(repo, sandbox):
    """--collect-only -q の出力からファイルの集合を取る。

    :: を含む行だけを採る。-q の出力には集計行や警告も混ざるため、
    外さないと集計行が偽のパスとして差分に出る。
    木構造の出力は形式が変わりやすいので使わない。
    """
    rc, out, err = run_cmd_in_sandbox(
        repo, sandbox,
        ["python3", "-m", "pytest", "--collect-only", "-q", "-p", "no:cacheprovider"],
    )
    files = set()
    for ln in out.splitlines():
        if "::" not in ln:
            continue
        files.add(os.path.normpath(os.path.join(repo, ln.split("::", 1)[0])))
    return rc, files, out + err


def run_python(repo, sandbox, extra_args=(), extra_ro=(), selftest=False):
    """pytest を1回走らせる。

    `-q` を固定で渡さない。合否の出典を `-v` の進捗行へ移したので、
    `-q` を残すと `-q -v` で verbosity が相殺され、進捗行が出なくなる
    （pytest は -q を -1、-v を +1 として足す）。verbosity は呼び出し側が決める。
    """
    rc, out, err = run_cmd_in_sandbox(
        repo, sandbox,
        ["python3", "-m", "pytest", "-p", "no:cacheprovider", *extra_args],
        extra_ro, selftest=selftest,
    )
    return rc, out + err


def run_shell(repo, sandbox, sh_files, extra_ro=()):
    """shell はファイル単位の終了コードだけを見る（Level 1）。

    集計行のパースはしない。3形式に割れており、5本は集計行を持たない。
    ケース単位の identity は #18 で bats へ移してから取る。
    """
    results = {}
    for rel in sh_files:
        # extra_ro を必ず渡す。受け取るだけで転送しないと、Task 10 の重ね掛けが
        # 黙って効かないまま走る。引数が構文的には在るので TypeError にもならず、
        # shell レーンの trust root だけが静かに無効化される。
        rc, _, _ = run_cmd_in_sandbox(
            repo, sandbox, ["bash", os.path.join(repo, rel)], extra_ro
        )
        results[rel] = rc
    return results


# --- shell レーン（--mutate） ---

# テストの起動の仕方。**拡張子ごとの正の一覧で持つ。**「一覧に無ければ bash」の
# ような既定を置かない。置くと、規約に足された拡張子（#18 の `.bats` への移行や
# その先の形式）が黙って bash で起動され、テストが1本も走らないまま
# analyze_mutants が全件を kill と数える。**知らない値は止まる側へ落とす。**
# 排除による定義（「これとこれ以外は無害」）は、知らない値が増えたときに
# 黙って無害側へ落ちる。#16 が塞ごうとしているのはその型そのもの。
SHELL_TEST_RUNNERS = {".sh": "bash", ".bats": "bats"}

# analyze_mutants は testscript の中のこの字面を変異体のパスへ展開し、
# **字面を含むかどうかで「変異体を対象ファイルへ置き換えるか」を決める**
# （analyze.py、ソースで確認）。含んでいると置き換えが起きず、全変異体で
# 原本のテストが走って「1件も kill されなかった」になる。
ANALYZE_MUTANT_TOKEN = "MUTANT"

# サンドボックスの HOME の中に作る変異体置き場。作業コピーとは分ける。
# 混ぜると道具が書いたものが作業コピーの中に見え、リポジトリを走査する形の
# テストが原本と違うものを見る。
SHELL_MUTANT_ROOT = "verify-tests-mutants"

# analyze_mutants へ渡す1件あたりの上限（秒）。**既定と同じ値を明示で渡す。**
# 渡さないと道具側の既定に依存し、上流が変えたときに測定の意味が黙って変わる。
# **超過は kill に数えられる**（SIGTERM のあとの終了コードを見るため）ので、
# 判別力ではなく機械の負荷で成績が動く。所要の計測後に見直してよい値。
SHELL_ANALYZE_TIMEOUT = "30"

# analyze_mutants へ「この変異体だけを走らせる」と伝えるファイル。
SHELL_KEEP_FILE = "verify-tests.keep"

# analyze_mutants が書く結果。**終了コードではなくこの2つを読む。**
# 変異体が1件も無くても 0 で終わる（analyze.py の `count == 0` の枝）。
SHELL_KILLED_FILE = "killed.txt"
SHELL_NOTKILLED_FILE = "notkilled.txt"


def shell_test_command(test_rel):
    """テストのパスから analyze_mutants へ渡す1つのコマンド文字列を作る。

    `analyze_mutants <対象> <テストスクリプト>` の契約は
    **「テストスクリプトが非0で終了したら kill」**で、スクリプトは `shell=True`
    で起動される（analyze.py で確認）。渡すのは文字列1つ。

    **起動の仕方は宣言を持つファイル自身の拡張子から決める。**対象の側から
    決めると、`.bats` への移行でテストだけが変わったときに追随しない。
    """
    ext = os.path.splitext(test_rel)[1]
    runner = SHELL_TEST_RUNNERS.get(ext)
    if runner is None:
        raise Unmeasurable(
            f"{test_rel}: 起動の仕方が決まっていない拡張子"
            f"（{ext or '拡張子が無い'}）")
    cmd = f"{runner} {shlex.quote(test_rel)}"
    if ANALYZE_MUTANT_TOKEN in cmd:
        raise Unmeasurable(
            f"{test_rel}: テストの命令に {ANALYZE_MUTANT_TOKEN} の字面を含められない")
    return cmd


def mutant_dir_name(target):
    """対象ごとの作業ディレクトリ名。**単射な符号化で作る。**

    `/` を `_` などへ潰すと、別々の対象が同じディレクトリを共有しうる。
    共有すると変異体が混ざったまま件数の照合だけが成立し、
    「対象 A の成績」に対象 B の変異体が入る。
    """
    return target.replace("%", "%25").replace("/", "%2F")


def inside_home(*parts):
    """サンドボックスの内側から見たパスを組み立てる。

    `build_bwrap` が `--bind <sandbox> $HOME` を張るので、ホスト側の
    `<sandbox>/x` は内側では `$HOME/x` として見える。
    """
    return os.path.join(os.path.expanduser("~"), *parts)


def mutant_names(target, names):
    """universalmutator が書いた変異体のファイル名だけを選ぶ。

    命名は `<拡張子を除いた名前>.mutant.<番号><拡張子>`（genmutants.py）。
    analyze_mutants は同じ置き場を `<名前>.mutant*<拡張子>` の glob で拾う
    （analyze.py）。**同じ集合になる形で選ぶ。**片方が規則ファイルや
    killed.txt を数えると、「走らせた件数」と「結果の件数」の照合が合わなくなり、
    照合そのものが意味を失う。
    """
    base, ext = os.path.splitext(os.path.basename(target))
    return sorted(n for n in names
                  if n.startswith(base + ".mutant.") and n.endswith(ext))


def _tail(text, n=3):
    lines = [ln for ln in (text or "").splitlines() if ln.strip()]
    return " / ".join(lines[-n:])


def _run_in_dir(repo, sandbox, workdir, argv):
    """サンドボックスの中の `workdir` へ降りて1つのコマンドを走らせる。

    作業コピーの中で走らせるヘルパは Task 2 に無いので、ここで cd を書く。
    """
    script = 'cd "$1" || exit 1\nshift\nexec "$@"'
    return run_cmd_in_sandbox(
        repo, sandbox, ["bash", "-c", script, "bash", workdir, *argv],
        mutate_binds())


def generate_shell_mutants(repo, sandbox, copy, target, include_python):
    """1つの対象の変異体を作業コピーの中で作り、`(ホスト側の置き場, 名前)` を返す。

    **`--noFastCheck` を必ず付ける。**付けないと universalmutator の
    「コメントまたは死んだコード」の判定が shell を理解できず、全行を
    読み飛ばして変異体0件で正常終了する（実測。合成の対象で 4件 → 0件、
    実物の check-issues.sh でも spec が同じことを記録している）。
    **正常終了するので、後段は「全部 kill された」と読む。**

    **規則は `--only` へ1つだけ渡す。**`--only` は規則ファイルを1つしか
    受け取らない（genmutants.py の `rules = [parsed.only]`）。`--cmd` は
    `TypeError` で落ち、`.rules` を位置引数で渡すと `.sh` で `KeyError` に
    なる（どちらも実測）。連結は Task 3 の `write_rules` が済ませている。
    """
    ext = os.path.splitext(os.path.basename(target))[1]
    if not ext:
        # 拡張子が無いと universalmutator が書く変異体名と analyze_mutants の
        # glob（`srcBase.replace(srcEnd, ...)`、srcEnd が空文字）が別物になる。
        raise Unmeasurable(f"{target}: 拡張子の無い対象は変異体を辿れない")
    name = mutant_dir_name(target)
    host = os.path.join(sandbox, SHELL_MUTANT_ROOT, name)
    inside = inside_home(SHELL_MUTANT_ROOT, name)
    shutil.rmtree(host, ignore_errors=True)
    os.makedirs(host)
    # 規則ファイルはホスト側で書く。同じ実体がサンドボックスの HOME なので、
    # 内側からは `$HOME/<置き場>/<名前>` として見える。
    rules = os.path.basename(write_rules(host, include_python))
    rc, out, err = _run_in_dir(
        repo, sandbox, inside,
        [os.path.join(MUTATE_VENV, "bin", "mutate"),
         os.path.join(copy, target), "--only", rules, "--noFastCheck"])
    if rc != 0:
        raise Unmeasurable(
            f"{target}: 変異体の生成が失敗した（rc={rc}）{_tail(err or out)}")
    return host, mutant_names(target, os.listdir(host))


def analyze_shell_mutants(repo, sandbox, copy, target, cmd, host, kept):
    """`kept` に挙げた変異体だけを analyze_mutants へ掛け、`(kill, 生き残り)` を返す。

    **終了コードで判定しない。**analyze_mutants は変異体が1件も無くても 0 で
    終わり（analyze.py の `count == 0` の枝）、そのとき killed.txt と
    notkilled.txt は空のまま作られる。読むのは2つのファイルで、
    **合計が走らせた件数と一致することまで見る。**一致を見ないと、道具が
    黙って落とした分が kill にも生き残りにも入らないまま成績から消える。

    `--noShuffle` を渡す。既定では順序が走行ごとに変わり、途中で止まった
    走行の結果を比べられなくなる。
    """
    inside = inside_home(SHELL_MUTANT_ROOT, mutant_dir_name(target))
    with open(os.path.join(host, SHELL_KEEP_FILE), "w") as f:
        f.write("\n".join(kept) + "\n")
    # テストは作業コピーのルートから走らせる。対象を相対パスで開くテストが
    # 多数なので、変異体置き場の側で走らせると原本も見つからない。
    rc, out, err = _run_in_dir(
        repo, sandbox, inside,
        [os.path.join(MUTATE_VENV, "bin", "analyze_mutants"),
         os.path.join(copy, target),
         f"cd {shlex.quote(copy)} && {cmd}",
         "--fromFile", SHELL_KEEP_FILE,
         "--noShuffle", "--timeout", SHELL_ANALYZE_TIMEOUT])
    if rc != 0:
        raise Unmeasurable(
            f"{target}: analyze_mutants が失敗した（rc={rc}）{_tail(err or out)}")
    killed = read_mutant_list(os.path.join(host, SHELL_KILLED_FILE), target)
    notkilled = read_mutant_list(os.path.join(host, SHELL_NOTKILLED_FILE), target)
    got = len(killed) + len(notkilled)
    if got != len(kept):
        raise Unmeasurable(
            f"{target}: 走らせた{len(kept)}件に対して結果が{got}件しか無い")
    unknown = sorted((set(killed) | set(notkilled)) - set(kept))
    if unknown:
        raise Unmeasurable(
            f"{target}: 走らせていない変異体の結果がある（{unknown[0]}）")
    return killed, notkilled


def read_mutant_list(path, target):
    try:
        with open(path) as f:
            return [ln.strip() for ln in f if ln.strip()]
    except OSError as e:
        raise Unmeasurable(f"{target}: {os.path.basename(path)} を読めない（{e}）")


def blank_shell_result(test_rel):
    """対象1つ分の入れ物。**測れなかった項目は None のまま返す。**

    0 で埋めると、「変異体を作る前に止まった」と「作ったが1件も無かった」が
    同じ字面になる。どこで止まったかが読めないと、門を1つ外しても別の門が
    代わりに拾って同じ結果になる状態に誰も気づけない。
    """
    return {"test": test_rel, "command": None, "python_rules": None,
            "mutants": None, "excluded": None, "analyzed": None,
            "killed": None, "survivors": None, "unmeasurable": None}


def shell_lane_target(repo, sandbox, copy, target, test_rel):
    """1つの対象を測る。門は上から順に、**通ってよい形を1つずつ数え上げる。**

    1. 作業コピーに対象が在る
    2. **原本が構文検査を通る**
    3. テストの起動の仕方が一覧に在る
    4. 変異を当てない状態でテストが 0 で終わる
    5. 変異体が1件以上作られた
    6. 構文検査を通った変異体が1件以上ある
    7. kill と生き残りの合計が、走らせた件数にちょうど一致する

    どれか1つでも欠けたら「計測できなかった」。**先へ進まない。**
    2 を先に見るのは、原本が壊れていればそこから作った変異体も全部壊れており、
    残せば全件が非0で終わって満点、落とせば「測れた変異体が0件」になるため。
    どちらも判別力とは無関係の結果が成績の顔をして出てくる。
    """
    got = blank_shell_result(test_rel)
    try:
        host_copy = os.path.join(sandbox, WORKTREE_COPY_NAME)
        source = os.path.join(host_copy, target)
        if not os.path.isfile(source):
            raise Unmeasurable(f"{target}: 作業コピーに対象が無い")
        is_py = needs_python_rules(source)
        got["python_rules"] = is_py
        if not syntax_ok(source, is_py):
            raise Unmeasurable(f"{target}: 原本が構文検査を通らない")
        got["command"] = cmd = shell_test_command(test_rel)
        rc, out, err = _run_in_dir(repo, sandbox, copy, ["bash", "-c", cmd])
        if rc != 0:
            raise Unmeasurable(
                f"{target}: 変異を当てない状態で {test_rel} が落ちる（rc={rc}）"
                f"{_tail(err or out)}")
        host, names = generate_shell_mutants(repo, sandbox, copy, target, is_py)
        got["mutants"] = len(names)
        if not names:
            raise Unmeasurable(f"{target}: 変異体を1件も作らなかった")
        kept, dropped = [], []
        for n in names:
            path = os.path.join(host, n)
            if syntax_ok(path, is_py):
                kept.append(n)
            else:
                dropped.append(
                    list(ids_from_universalmutator(target, path, host_copy)))
        got["excluded"] = dropped
        if not kept:
            raise Unmeasurable(
                f"{target}: 構文検査を通った変異体が1件も無い"
                f"（{len(names)}件のうち{len(dropped)}件を除外）")
        killed, notkilled = analyze_shell_mutants(
            repo, sandbox, copy, target, cmd, host, kept)
        got["analyzed"] = len(kept)
        got["killed"] = len(killed)
        got["survivors"] = [
            list(ids_from_universalmutator(target, os.path.join(host, n),
                                           host_copy))
            for n in notkilled]
    except Unmeasurable as e:
        got["unmeasurable"] = str(e)
    return got


def run_shell_lane(repo, sandbox, pairs):
    """shell レーンを対象ごとに回し、対象ごとの成績を返す。

    **対象ごとに1本のテストで判定する。**Python レーンと逆になるが、shell の
    テストは対象と1対1で書かれていて他の対象を触らないため、全18本を回しても
    kill の判定はまず変わらず所要だけが18倍になる。

    **ループを `main` の中へ畳まない。**呼び出し関係を見る検査は
    トップレベルの関数しか区別しないので、`main` に畳むと「変異体ごとに
    本番資産の前後比較を取っていないか」（受け入れ条件40）の見張りが
    `main` の一語に潰れ、実際に取っていても素通りする。

    **測れなかった対象も鍵として残す。**落とすと、後段が「対象が消えた」と
    「もともと無い」を区別できず、基準を静かに刈る経路ができる。
    """
    copy = make_worktree_copy(repo, sandbox)
    out = {}
    for target, test_rel in pairs:
        if copy is None:
            got = blank_shell_result(test_rel)
            got["unmeasurable"] = f"{target}: 作業コピーを作れなかった"
        else:
            got = shell_lane_target(repo, sandbox, copy, target, test_rel)
        out[target] = got
    return out


# 監視対象。環境変数で使い捨てのパスへ差し替えられる。
DEFAULT_WATCHED = [
    os.path.expanduser("~/.claude/logs/memory-recall.log*"),
    os.path.expanduser("~/.claude/projects/*/memory/.embeddings.json*"),
    os.path.expanduser("~/.claude/projects/*/memory/*.md"),
    os.path.expanduser("~/.local/share/chezmoi"),
]

# 判定に算入しないもの。テスト以外の経路で日常的に変わるため。
# memory_recall.py が UserPromptSubmit フックとして書くので、
# テストの実行中に別のセッションでプロンプトが走れば変化する。
DEFAULT_WATCHED_EXCLUDE = [
    os.path.expanduser("~/.claude/logs/memory-recall.log*"),
    os.path.expanduser("~/.claude/projects/*/memory/.embeddings.json*"),
    os.path.expanduser("~/.claude/projects/*/memory/*.md"),
]


def _env_list(name, default):
    raw = os.environ.get(name)
    if raw is None:
        return default
    return [p for p in raw.split("\n") if p.strip()]


def _expand(patterns):
    out = set()
    for pat in patterns:
        for hit in glob.glob(pat):
            if os.path.isdir(hit):
                for root, dirs, files in os.walk(hit):
                    dirs[:] = [d for d in dirs if d != ".git"]
                    for f in files:
                        out.add(os.path.join(root, f))
            else:
                out.add(hit)
    return out


def snapshot_watched():
    snap = {}
    for path in _expand(_env_list("VERIFY_TESTS_WATCHED", DEFAULT_WATCHED)):
        try:
            st = os.stat(path)
        except OSError:
            continue
        snap[path] = (st.st_mtime_ns, st.st_size)
    return snap


def diff_watched(before, after):
    """変化を「判定に算入するもの」と「但し書き」に分ける。

    除外にあるファイルの変化も報告する。黙って捨てない。
    """
    excluded = _expand(_env_list("VERIFY_TESTS_WATCHED_EXCLUDE",
                                 DEFAULT_WATCHED_EXCLUDE))
    counted, noted = [], []
    for path in sorted(set(before) | set(after)):
        if before.get(path) == after.get(path):
            continue
        (noted if path in excluded else counted).append(path)
    return counted, noted


def watched_report(before):
    """前後比較を取り、報告し、判定に算入する分を返す。

    main の脱出経路が3つあるので、各所で呼ぶ。1箇所へ寄せると
    --discover-only と REVIEW の経路で guard が走らない。
    """
    counted, noted = diff_watched(before, snapshot_watched())
    for path in counted:
        print(f"== 本番へ書いた: {path}")
    for path in noted:
        print(f"== 変化（判定に算入しない）: {path}")
    return counted


def merge_base(repo):
    out = subprocess.run(
        ["git", "-C", repo, "merge-base", "HEAD", "origin/main"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        return None
    return out.stdout.strip()


def base_worktree(repo, sha):
    """merge-base の内容を使い捨てのワークツリーへ出す。

    永続 baseline を持たないので、基準は毎回 git history から作り直す。
    全件10秒弱なので、キャッシュが外れたら保守的に再実行へ倒せる。
    """
    path = tempfile.mkdtemp(prefix="verify-tests-base.")
    out = subprocess.run(
        ["git", "-C", repo, "worktree", "add", "--detach", "-f", path, sha],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        shutil.rmtree(path, ignore_errors=True)
        return None
    return path


def drop_base_worktree(repo, path):
    subprocess.run(["git", "-C", repo, "worktree", "remove", "--force", path],
                   capture_output=True, text=True)
    subprocess.run(["git", "-C", repo, "worktree", "prune"],
                   capture_output=True, text=True)
    shutil.rmtree(path, ignore_errors=True)


# -v の進捗行。`<nodeid> <結果>[ (理由)] [ NN%]` の形をしている。
# 行頭が nodeid（`::` を含む）であることと、行末が進捗の百分率であることの
# 両方を条件にする。前者だけだと、失敗時に出る捕捉済み標準出力の行が
# たまたま同じ形をしていると拾ってしまう。
#
# 錨は結果語の側に打つ。nodeid を `\S+` で取ると `test_p[hello world]` のような
# parametrize 済みの nodeid で行ごとマッチせず、その case が base 側にも
# candidate 側にも現れないまま消える。regressions にも disappeared にも
# 載らないので、赤くなっても検出されない（issue #28）。
#
# 二段に分けるのは、nodeid と理由の両方が自由テキストで、どちらにも結果語が
# 入りうるため。厳密版は理由を丸括弧の1組に限って、結果語の位置を
# 後続の形から逆算させる。緩い版は理由の形を仮定しない代わりに nodeid を
# 貪欲に取る。厳密版で解けない出力形が来たときに行ごと落とさないための
# 受け皿で、落とすと上と同じ「静かに消える」型に戻る。
PROGRESS_STRICT_RE = re.compile(
    r"^(?P<nodeid>\S.*?::.*?)\s+"
    r"(?P<outcome>PASSED|FAILED|ERROR|SKIPPED|XFAIL|XPASS)"
    r"(?:\s+\([^)]*\))?"
    r"\s+\[\s*\d+%\]$"
)
PROGRESS_LOOSE_RE = re.compile(
    r"^(?P<nodeid>\S.*::.*)\s+"
    r"(?P<outcome>PASSED|FAILED|ERROR|SKIPPED|XFAIL|XPASS)\b"
    r".*\[\s*\d+%\]$"
)


def parse_pytest_outcomes(out):
    """ケース単位の合否を、`-v` の進捗行から nodeid ごとに取る。

    **出典を `-rA` の短い要約から `-v` の進捗行へ移してある。**要約行は skip を
    `SKIPPED [1] path/to/file.py:33: 理由` の形で出し、nodeid ではなくファイルと
    行番号を持つ（実測）。素直に読むと `[1]` が nodeid の位置に入り、その走行の
    skip が全部この1つの鍵へ潰れる。結果として skip されたケースが判定から消え、
    `skipif` を1つ足すだけで赤いテストが黙って緑になる。この道具が防ぐために
    在る型の失敗そのものなので、要約行は出典にしない。

    `--junit-xml` も採らない。`testcase` の `classname` は
    `deep.nested.dir.test_x.TestY` のようにディレクトリの区切りとモジュール名の
    ドットを同じ文字へ潰した形で、`file` 属性は付かない（実測）。nodeid の
    パスへ確実に戻す手段が無い。

    `-v` の進捗行は nodeid をそのまま持ち、skip も pass も同じ形で1行ずつ出る。
    """
    res = {}
    for ln in out.splitlines():
        s = ln.strip()
        m = PROGRESS_STRICT_RE.match(s) or PROGRESS_LOOSE_RE.match(s)
        if m:
            res[m.group("nodeid")] = m.group("outcome")
    return res


def evaluate(tree, extra_ro=(), collect_only=False):
    """1つのツリーを1回走らせて、判定に要るものを全部返す。

    R1（merge-base × merge-base のテスト）、R2（candidate × merge-base のテスト）、
    R3（candidate × candidate のテスト）の3回とも、この関数を通る。

    collect_only=True のときは収集で止める。--discover-only がこれを使う。
    走らせてしまうと `/morning` が毎朝両リポジトリの全件を回すことになり、
    「実行せず、discovery の検査と収集の差分だけを見る」という口の定義から外れる。
    """
    sandbox = make_sandbox_home()
    try:
        if not sandbox_started(tree, sandbox):
            return {"sandbox_ok": False}
        tracked = tracked_files(tree, sandbox)
        if tracked is None:
            return {"sandbox_ok": True, "ls_files_ok": False}
        py, sh = target_tests(tree, tracked)
        rc_collect, collected, _ = collected_files(tree, sandbox)
        missing, unexpected = collection_diff(tree, py, collected)
        out = {
            "sandbox_ok": True, "ls_files_ok": True,
            "tracked": tracked, "py": py, "sh": sh,
            "collected": collected, "rc_collect": rc_collect,
            "missing": missing, "unexpected": unexpected,
            "discovery": check_discovery_policy(tree),
            "results": {}, "rc_run": 0, "sh_green": 0, "sh_total": 0,
        }
        if collect_only:
            return out
        rc_run, run_out = run_python(tree, sandbox, ["--tb=no", "-v"], extra_ro)
        results = parse_pytest_outcomes(run_out)
        sh_rc = run_shell(tree, sandbox, sh, extra_ro)
        for rel, rc in sh_rc.items():
            results[rel] = "PASS" if rc == 0 else "FAIL"
        out.update({
            "results": results, "rc_run": rc_run,
            "sh_green": sum(1 for rc in sh_rc.values() if rc == 0),
            "sh_total": len(sh_rc),
        })
        return out
    finally:
        shutil.rmtree(sandbox, ignore_errors=True)


# 合否の語彙は2系統ある。pytest は PASSED / FAILED / ERROR / SKIPPED、
# shell レーンは PASS / FAIL。片方だけで照合すると、Python の赤が
# 既知の赤の格上げからも known-red の集計からも漏れる。
RED = {"FAIL", "FAILED", "ERROR"}
GREEN = {"PASS", "PASSED"}


def is_red(v):
    return v in RED


def regressions(base, cand):
    """base で赤くなく、candidate で赤くなったものを返す。

    red -> red は regression に算入しない。既知の赤と共存するため。
    base に無い（新しく足された）ものが赤い場合も返す。
    """
    out = []
    for key, val in sorted(cand.items()):
        if not is_red(val):
            continue
        # base で赤くなければ regression。緑からの悪化、base に無い新規、
        # skip からの悪化のいずれも拾う。**見逃すのは red -> red だけ。**
        # `base.get(key) in GREEN` で書くと、base が SKIPPED のものが
        # candidate で落ちても拾えない。自テストが skip を多用するので実害が出る。
        if not is_red(base.get(key)):
            out.append(key)
    return out


def disappeared(base, cand):
    """base で緑だったのに candidate では緑と言えなくなったものを返す。

    regression とは別の分類にする。**候補は「消えた」か「skip になった」で、
    赤くはない。**赤ければ regressions が拾う。ここが拾うのは、
    ケースが candidate の走行に現れなくなった場合（削除、deselect、
    読み込み時 skip）と、SKIPPED / XFAIL のように結果が緑でなくなった場合。

    regressions は candidate 側の鍵だけを回すので、この2つを原理的に見ない。
    分けずに regression へ混ぜると、正当な削除まで FAIL になる。受け入れ条件34b が
    「正当な削除は REVIEW」と定めているので、判定は REVIEW へ落とす。
    緑が消えたことは機械には正誤を決められないが、黙って通してよくもない。
    """
    out = []
    for key, val in sorted(base.items()):
        if val not in GREEN:
            continue
        now = cand.get(key)
        if now in GREEN or is_red(now):
            continue
        out.append(key)
    return out


def harness_failure_reasons(r, full=True):
    """検査そのものが成立しなかった理由を集める。引数は evaluate の戻り値。

    full=False のときは「走らせること自体ができなかった」3つだけを見る。
    R1 と R2 はこちらで呼ぶ。**導入の初回、merge-base には pyproject.toml も
    verify-tests も無い。**R1 にも構造の検査を当てると「pyproject.toml が
    ありません」が必ず立ち、判定が実行の門へ届かないまま FAIL を返す。
    pre-push は --strict を呼ぶので push も止まり、origin/main を進める手段が
    --no-verify だけになる。仕組みが自分で自分を塞ぐ。

    pytest の終了コードは0と1以外をすべてここへ落とす。
    2が収集エラー、3が内部エラー、4が使い方の誤り、5が収集0件。
    """
    if not r.get("sandbox_ok"):
        return ["bwrap の起動に失敗した"]
    if not r.get("ls_files_ok"):
        return ["git ls-files が失敗した"]
    reasons = []
    for name, rc in (("収集", r.get("rc_collect", 0)), ("本走行", r.get("rc_run", 0))):
        if rc not in (0, 1):
            reasons.append(f"{name}が終了コード {rc} を返した")
    if not full:
        return reasons
    for p in r.get("discovery", []):
        reasons.append(f"discovery policy: {p}")
    for m in r.get("missing", []):
        reasons.append(f"走らなかった: {m}")
    for u in r.get("unexpected", []):
        reasons.append(f"収集されたが候補に無い: {u}")
    return reasons


# 検証者そのもの。chezmoi を対象にするとき、これは candidate の中にある。
VERIFIER_SOURCE = "dot_local/private_bin/executable_verify-tests"


def trusted_artifacts(tracked):
    """次の base になりうるもの。テスト・検証者・discovery policy。

    検証者を含めるのは、実行の門では守れないため。実際に走るのは
    PATH 上の ~/.local/bin/verify-tests なので、ツリーの中のソースを
    ro-bind で被せても実行される実体は変わらない。昇格の門で受ける。
    """
    out = []
    for path in tracked:
        base = os.path.basename(path)
        if match_any(base, PY_PATTERNS) or match_any(base, SH_PATTERNS):
            out.append(path)
        elif base in ("pyproject.toml", "conftest.py", ".pre-commit-config.yaml"):
            out.append(path)
        elif path == VERIFIER_SOURCE:
            out.append(path)
    return sorted(out)


def trusted_overlay(base_tree, cand_tree, base_tracked):
    """base のテスト群を candidate のツリーの上へ読み取り専用で重ねる。

    --root も一時実行ツリーも overlay FS も要らない。bind mount が
    そのまま overlay の役割を果たし、実ファイルは変わらない（実測）。

    単位はファイル1つずつ。ディレクトリごと重ねると candidate の実装が
    base のもので隠れ、trust root が base を base で判定するだけになる。

    相対構造は bind 先のパスが保つ。重ねる先が candidate の中の同じパスなので、
    $HERE も $(dirname)/.. も同一ディレクトリからの import も、
    すべて candidate のツリーの中で解決される。
    """
    pairs = []
    for rel in trusted_artifacts(base_tracked):
        src = os.path.normpath(os.path.join(base_tree, rel))
        dst = os.path.normpath(os.path.join(cand_tree, rel))
        # 両方に実在するものだけを重ねる。candidate が削除またはリネームした
        # テストは dst が無く、bwrap は存在しないパスへ重ねようとすると
        # Read-only file system で rc=1 を返す（実測）。この値は pytest の
        # 「テストが落ちた」と同じなので、素直に渡すと正当な削除が
        # 機構の失敗へ落ちる。削除を捕まえるのは昇格の門の側。
        if os.path.isfile(src) and os.path.isfile(dst):
            pairs.append((src, dst))
    return pairs


def execution_gate(base_regressions, cand_regressions):
    """base のテストと candidate のテストを両方 candidate へ当てた結果を見る。"""
    base_ok = not base_regressions
    cand_ok = not cand_regressions
    if base_ok and cand_ok:
        return "PASS"
    if not base_ok and cand_ok:
        return "REVIEW"   # 契約変更の可能性。機械では意図を決められない
    return "FAIL"


def promotion_gate(repo, base_sha, base_tracked):
    """candidate の契約を次の base にしてよいかを別に見る。

    実行の門だけでは「実装は壊さず、次回から弱くする」を捕まえられない。
    今回の candidate が壊れていなくても、弱くなったテストが次の trust root になる。

    判定は byte-for-byte の同一性だけを使う。diff の見た目から
    「削除または弱める方向」を推測しない。
    """
    changed = []
    for rel in trusted_artifacts(base_tracked):
        out = subprocess.run(
            ["git", "-C", repo, "diff", "--quiet", base_sha, "--", rel],
            capture_output=True, text=True,
        )
        if out.returncode != 0:
            changed.append(rel)
    return changed


def touched_known_red(repo, base_sha, base_res, cand_res):
    """既知の赤とその対象を今回の patch が触ったか。

    無関係な作業を既知の赤で止めないための ratchet が、
    赤い領域を触った変更まで盲目的に通すのを防ぐ。

    対象実装の対応は命名規約で決める。推論はしない。当たらないものは
    テストファイル自身を触った場合だけ格上げの対象になる。
    """
    red_files = {k.split("::", 1)[0] for k, v in base_res.items() if is_red(v)}
    still_red_files = {k.split("::", 1)[0] for k, v in cand_res.items() if is_red(v)}
    out = subprocess.run(
        ["git", "-C", repo, "diff", "--name-only", base_sha],
        capture_output=True, text=True,
    )
    touched = {ln for ln in out.stdout.splitlines() if ln.strip()}

    escalate = []
    for test in sorted(red_files & still_red_files):
        # テスト自身を触ったか、命名規約で対応づく実装を触ったか。
        # 実装ファイルは cand_res に現れないので、交差ではなく
        # テストごとに「触られた集合」を作って判定する。
        related = {test} | implementation_of(test)
        if related & touched:
            escalate.append(test)
    return escalate


def implementation_of(test_path):
    """テストに対応する実装を命名規約だけで決める。

    規約に当たらないものは空を返す。推論しに行くと、外れたときに
    黙って通す側へ倒れる。
    """
    d = os.path.dirname(test_path)
    base = os.path.basename(test_path)
    cands = []
    if base.endswith(".test.sh"):
        stem = base[: -len(".test.sh")]
        cands.append(stem + ".sh")
        if stem.startswith("executable_"):
            # 接頭辞を落とした形も候補にする。`bash <path>` で呼ばれるフックは
            # 実行ビットが要らないので接頭辞を持たない。
            # executable_guard-unsandboxed-pytest.test.sh の本体は
            # guard-unsandboxed-pytest.sh で、接頭辞付きだけを見ると対応が付かない。
            cands.append(stem[len("executable_"):] + ".sh")
        else:
            cands.append("executable_" + stem + ".sh")
    elif base.startswith("test_") and base.endswith(".py"):
        cands.append(base[len("test_"):])
    elif base.startswith("test_") and base.endswith(".sh"):
        cands.append(base[len("test_"):])
    return {os.path.join(d, c) if d else c for c in cands}


def verdict(payload):
    """三値を決める唯一の場所。

    execution_gate は「base レーンと candidate レーンの差分」だけを見る。
    機構の失敗と本番への書き込みは、そこより先に立って FAIL を返す。
    優先順位は 機構の失敗 → 本番へ書いた → 実行の門 → 昇格の門 → 既知の赤
    → 緑が消えた。
    """
    if payload.get("harness_failed"):
        return "FAIL"
    if payload.get("wrote_production"):
        return "FAIL"
    gate = execution_gate(payload["base_regressions"], payload["cand_regressions"])
    if gate == "FAIL":
        return "FAIL"
    if gate == "REVIEW":
        return "REVIEW"
    if (payload.get("contract_changed") or payload.get("touched_red")
            or payload.get("disappeared")):
        return "REVIEW"
    return "PASS"


RESULT_PATH = os.path.expanduser("~/.cache/verify-tests/last-result.json")


def write_result(repo, verdict_value, counts):
    """判定結果を専用のファイルへ書く。

    Stop フックの入力には「直前に検証が成功した」を表す欄が無く、
    PostToolUse(Bash) の結果には数値の終了コードが記録されていない（実測）。
    使える経路は結果ファイル1つになる。
    突合しないと古い PASS で門を通せるので、作業ツリーの指紋を添える。
    """
    head = subprocess.run(["git", "-C", repo, "rev-parse", "HEAD"],
                          capture_output=True, text=True).stdout.strip()
    tree = current_tree(repo)   # index ではなく作業ツリーの指紋
    os.makedirs(os.path.dirname(RESULT_PATH), exist_ok=True)
    with open(RESULT_PATH, "w") as f:
        json.dump({
            "repo": repo, "head": head, "tree": tree,
            "verifier_version": VERSION, "verdict": verdict_value,
            "counts": counts,
        }, f)


def summarize(verdict_value, counts, details):
    """PASS のときは1行。FAIL と REVIEW のときだけ差分を返す。

    保証レベルも1行に含める。shell がファイル単位であることを
    読み手が知らないまま「緑だから安全」と受け取らないようにする。
    """
    if verdict_value == "PASS":
        names = ", ".join(os.path.basename(x) for x in counts["excluded"])
        ex = f" / 対象外 {names}" if counts["excluded"] else ""
        return (f"PASS  python={counts['py_cases']} "
                f"shell={counts['sh_green']}/{counts['sh_total']} green "
                f"+ {counts['known_red']} known-red unchanged "
                f"(shell はファイル単位 / Level 1{ex})")
    lines = [verdict_value]
    lines += [f"  {d}" for d in details]
    return "\n".join(lines)


ACCEPT_PATH = os.path.expanduser("~/.cache/verify-tests/accepted.json")


def current_tree(repo):
    """作業ツリーの指紋。

    `git write-tree` は index を見るので、未 stage の編集では値が変わらない
    （実測）。一方 promotion_gate と touched_known_red は `git diff <base>` を
    使うので作業ツリーを見る。承認だけ index に紐づけると、一度承認したあとに
    未 stage の編集をいくらでも重ねられ、毎回 REVIEW が PASS へ昇格する。
    判定と同じ側（作業ツリー）へ揃える。
    """
    import hashlib
    h = hashlib.sha256()
    for cmd in (["rev-parse", "HEAD"], ["diff", "HEAD"]):
        h.update(subprocess.run(["git", "-C", repo] + cmd,
                                capture_output=True, text=True).stdout.encode())
        h.update(b"\x00")
    # 追跡外ファイルは名前だけでなく中身まで入れる。git status --porcelain は
    # 名前しか出さず、git diff HEAD は追跡外を含まないので、名前だけだと
    # 追跡外テストの中身を書き換えても指紋が変わらない（実測で確認）。
    # pytest は追跡外のテストも収集するので、中身は検証結果を左右する入力。
    others = subprocess.run(
        ["git", "-C", repo, "ls-files", "--others", "--exclude-standard", "-z"],
        capture_output=True, text=True).stdout.split("\0")
    for rel in sorted(x for x in others if x):
        h.update(rel.encode() + b"\x00")
        try:
            with open(os.path.join(repo, rel), "rb") as f:
                h.update(f.read())
        except OSError:
            h.update(b"<unreadable>")
        h.update(b"\x00")
    return h.hexdigest()


def load_accepted(path):
    """受理記録を `{リポジトリ: レコード}` で返す。読めなければ空。

    旧形式（レコード1件を直に持つオブジェクト）もここで新形式へ寄せる。
    寄せずに捨てると、道具を更新した時点で有効だった受理が黙って外れる。
    """
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    if "repo" in data and "tree" in data:
        return {data["repo"]: data}
    return {k: v for k, v in data.items() if isinstance(v, dict)}


def store_accepted(path, repo, record):
    """1リポジトリ分の受理を、他のリポジトリの受理を消さずに書く。

    以前は単一のオブジェクトを丸ごと上書きしていたため、2つ目を受理した時点で
    1つ目が黙って `REVIEW` へ戻っていた。押した順序で結果が変わり、
    利用者からは「受理したはずなのに通らない」としか見えない（issue #29）。
    この道具は2つのリポジトリを対象にする設計なので、器も対象の数だけ要る。
    """
    recs = load_accepted(path)
    recs[repo] = record
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(recs, f)


def accept_review(repo, reason):
    """今のツリー1つに紐づく承認を書く。

    台帳にならない。承認は特定のツリーにしか効かず、将来の変更へ持ち越せない。
    ファイルを1バイトでも編集すればツリーが変わって外れる。
    """
    store_accepted(ACCEPT_PATH, repo,
                   {"repo": repo, "tree": current_tree(repo),
                    "verifier_version": VERSION, "reason": reason})


def accepted_for_current_tree(repo):
    rec = load_accepted(ACCEPT_PATH).get(repo)
    if not rec:
        return False
    return (rec.get("tree") == current_tree(repo)
            and rec.get("verifier_version") == VERSION)


