            files, modes = [], {}
            for root, _, names in os.walk(host):
                for n in names:
                    p = os.path.join(root, n)
                    rel = os.path.relpath(p, host)
                    files.append(rel)
                    modes[rel] = oct(os.stat(p).st_mode & 0o777)
            print(json.dumps({
                "copy": copy, "files": sorted(files), "modes": modes,
                "tracked": sorted(tracked_files(tree, sandbox) or []),
