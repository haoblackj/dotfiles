            # 「サンドボックスの中から cosmic-ray と universalmutator が起動できる」
            # を確かめる手段がこの道具の中に一つも無くなる。R1 / R2 / R3 へは
            # 広げないので、差分判定の走行は従来どおり venv を見ない。
            #
            # chezmoi のソース側も同じ理由でこの口にだけ見せる。shell テスト
            # 18本のうち11本はソース側にしか無いので、足さないと「両リポジトリで
            # 18本を過不足なく拾う」（受け入れ条件10）を確かめる手段が無くなる。
            rc, out = run_python(repo, sandbox, passthrough,
                                 deployed_tool_bind() + mutate_binds()
                                 + chezmoi_source_bind(),
                                 selftest=True)
            print(out)
            return rc          # 検査の口ではないので分類に落とさない
        finally:
            shutil.rmtree(sandbox, ignore_errors=True)

    before = snapshot_watched()

    r3 = evaluate(repo, collect_only=discover_only)     # candidate × candidate
    if discover_only:
        reasons = harness_failure_reasons(r3)
        for x in reasons:
            print(f"== {x}")
        print(f"== 収集: {len(r3.get('collected', ()))}ファイル")
        # --discover-only は全モジュールを import する経路そのもので、
        # まさに本番へ書きうる。ここで guard を走らせないと、この口だけが
        # 本番資産の比較を素通りする。
        counted = watched_report(before)
        return 1 if ((reasons or counted) and strict) else 0

    sha = merge_base(repo)
    base_tree = base_worktree(repo, sha) if sha else None
    if base_tree is None:
        # REVIEW を名乗る以上、--strict では非0を返す。0 を返すと
        # pre-push が「判定に必要な情報が揃わなかった」走行を素通しする。
        # 受け入れ条件44（--strict は FAIL と REVIEW の両方で非0）がこれに当たる。
        print("REVIEW  merge-base を用意できないため判定に必要な情報が揃いません")
        watched_report(before)
        return 1 if strict else 0
    try:
        r1 = evaluate(base_tree)                        # base × base
        overlay = trusted_overlay(base_tree, repo, r1.get("tracked", []))
        r2 = evaluate(repo, extra_ro=overlay)           # candidate × base のテスト
        base_regressions = regressions(r1.get("results", {}), r2.get("results", {}))
        counted = watched_report(before)
        cand_regressions = regressions(r1.get("results", {}), r3.get("results", {}))
        # 緑が消えたケース。base レーンと candidate レーンの両方で見る。
        # base レーンは「candidate の実装のせいで base のテストが skip になった」を、
        # candidate レーンは「candidate がテストを消した・skip にした」を拾う。
        base_disappeared = disappeared(r1.get("results", {}), r2.get("results", {}))
        cand_disappeared = disappeared(r1.get("results", {}), r3.get("results", {}))
        # R1 と R2 は full=False。構造の検査と収集の差分を当てない。
        # 当てると導入の初回に merge-base が必ず落ち、仕組みが自分で自分を塞ぐ。
        reasons = (harness_failure_reasons(r3)
                   + harness_failure_reasons(r1, full=False)
                   + harness_failure_reasons(r2, full=False))
        changed_artifacts = promotion_gate(repo, sha, r1.get("tracked", []))
        touched_red_files = touched_known_red(
            repo, sha, r1.get("results", {}), r3.get("results", {}))
        payload = {
            "harness_failed": bool(reasons),
            "wrote_production": bool(counted),
            "base_regressions": base_regressions,
            "cand_regressions": cand_regressions,
            "contract_changed": bool(changed_artifacts),
            "touched_red": bool(touched_red_files),
            "disappeared": bool(base_disappeared or cand_disappeared),
        }
        v = verdict(payload)
        counts = {
            "py_cases": sum(1 for k in r3.get("results", {}) if "::" in k),
            "sh_green": r3.get("sh_green", 0),
            "sh_total": r3.get("sh_total", 0),
            "known_red": sum(1 for x in r1.get("results", {}).values() if is_red(x)),
            # そのリポジトリに実在するものだけを出す。SHELL_EXCLUDED は
            # 両リポジトリ分を持つ定数なので、絞らないと penguinEx を対象に
            # したときに chezmoi の本の名前が出て紛らわしい。
            "excluded": sorted(SHELL_EXCLUDED & set(r3.get("tracked", []))),
        }
        # REVIEW の理由も details へ入れる。入れないと、実行の門が両レーンとも
        # 綺麗なまま昇格の門だけが立った場合に、出力が `REVIEW` の一語だけになり
        # 「なぜ REVIEW なのか」が読めない。失敗時は次の一手に要る差分だけを返す、
        # という出力契約の趣旨から外れる。
        # 本番資産への書き込みはここへ入れない。watched_report が既に1件1行で
        # 印字しており、details にも入れると同じ行が2度出る。watched_report の側を
        # 残すのは、そちらが --discover-only と merge-base 不成立の経路も覆うため。
        details = (reasons
                   + [f"新規 regression: {k}" for k in cand_regressions]
                   + [f"旧契約を破った: {k}" for k in base_regressions]
                   + [f"契約を変更した: {k}" for k in changed_artifacts]
                   + [f"既知の赤を触った: {k}" for k in touched_red_files]
                   + [f"緑が消えた（candidate のテスト）: {k}"
                      for k in cand_disappeared]
                   + [f"緑が消えた（base のテストを candidate へ当てた）: {k}"
                      for k in base_disappeared])
        if v == "REVIEW" and accepted_for_current_tree(repo):
            v = "PASS"
        print(summarize(v, counts, details))
        write_result(repo, v, counts)
        return 1 if (strict and v != "PASS") else 0
    finally:
        drop_base_worktree(repo, base_tree)


sys.exit(main(sys.argv[1:]))
