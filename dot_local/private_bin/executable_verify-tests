def _env_list(name, default):
    raw = os.environ.get(name)
    if raw is None:
        return default
    return [p for p in raw.split("\n") if p.strip()]


def _expand(patterns):
    out = set()
    for pat in patterns:
        for hit in glob.glob(pat):
            if os.path.isdir(hit):
                for root, dirs, files in os.walk(hit):
                    dirs[:] = [d for d in dirs if d != ".git"]
                    for f in files:
                        out.add(os.path.join(root, f))
            else:
                out.add(hit)
    return out


def snapshot_watched():
    snap = {}
    for path in _expand(_env_list("VERIFY_TESTS_WATCHED", DEFAULT_WATCHED)):
        try:
            st = os.stat(path)
        except OSError:
            continue
        snap[path] = (st.st_mtime_ns, st.st_size)
    return snap


def diff_watched(before, after):
    """変化を「判定に算入するもの」と「但し書き」に分ける。

    除外にあるファイルの変化も報告する。黙って捨てない。
    """
    excluded = _expand(_env_list("VERIFY_TESTS_WATCHED_EXCLUDE",
                                 DEFAULT_WATCHED_EXCLUDE))
    counted, noted = [], []
    for path in sorted(set(before) | set(after)):
        if before.get(path) == after.get(path):
            continue
        (noted if path in excluded else counted).append(path)
    return counted, noted


def watched_report(before):
    """前後比較を取り、報告し、判定に算入する分を返す。

    main の脱出経路が3つあるので、各所で呼ぶ。1箇所へ寄せると
    --discover-only と REVIEW の経路で guard が走らない。
    """
    counted, noted = diff_watched(before, snapshot_watched())
    for path in counted:
        print(f"== 本番へ書いた: {path}")
    for path in noted:
        print(f"== 変化（判定に算入しない）: {path}")
    return counted


def merge_base(repo):
    out = subprocess.run(
        ["git", "-C", repo, "merge-base", "HEAD", "origin/main"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        return None
    return out.stdout.strip()


def base_worktree(repo, sha):
    """merge-base の内容を使い捨てのワークツリーへ出す。

    永続 baseline を持たないので、基準は毎回 git history から作り直す。
    全件10秒弱なので、キャッシュが外れたら保守的に再実行へ倒せる。
    """
    path = tempfile.mkdtemp(prefix="verify-tests-base.")
    out = subprocess.run(
        ["git", "-C", repo, "worktree", "add", "--detach", "-f", path, sha],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        shutil.rmtree(path, ignore_errors=True)
        return None
    return path


def drop_base_worktree(repo, path):
    subprocess.run(["git", "-C", repo, "worktree", "remove", "--force", path],
                   capture_output=True, text=True)
    subprocess.run(["git", "-C", repo, "worktree", "prune"],
                   capture_output=True, text=True)
    shutil.rmtree(path, ignore_errors=True)


# -v の進捗行。`<nodeid> <結果>[ (理由)] [ NN%]` の形をしている。
# 行頭が nodeid（`::` を含む）であることと、行末が進捗の百分率であることの
# 両方を条件にする。前者だけだと、失敗時に出る捕捉済み標準出力の行が
# たまたま同じ形をしていると拾ってしまう。
#
# 錨は結果語の側に打つ。nodeid を `\S+` で取ると `test_p[hello world]` のような
# parametrize 済みの nodeid で行ごとマッチせず、その case が base 側にも
# candidate 側にも現れないまま消える。regressions にも disappeared にも
# 載らないので、赤くなっても検出されない（issue #28）。
#
# 二段に分けるのは、nodeid と理由の両方が自由テキストで、どちらにも結果語が
# 入りうるため。厳密版は理由を丸括弧の1組に限って、結果語の位置を
# 後続の形から逆算させる。緩い版は理由の形を仮定しない代わりに nodeid を
# 貪欲に取る。厳密版で解けない出力形が来たときに行ごと落とさないための
# 受け皿で、落とすと上と同じ「静かに消える」型に戻る。
PROGRESS_STRICT_RE = re.compile(
    r"^(?P<nodeid>\S.*?::.*?)\s+"
    r"(?P<outcome>PASSED|FAILED|ERROR|SKIPPED|XFAIL|XPASS)"
    r"(?:\s+\([^)]*\))?"
    r"\s+\[\s*\d+%\]$"
)
PROGRESS_LOOSE_RE = re.compile(
    r"^(?P<nodeid>\S.*::.*)\s+"
    r"(?P<outcome>PASSED|FAILED|ERROR|SKIPPED|XFAIL|XPASS)\b"
    r".*\[\s*\d+%\]$"
)


def parse_pytest_outcomes(out):
    """ケース単位の合否を、`-v` の進捗行から nodeid ごとに取る。

    **出典を `-rA` の短い要約から `-v` の進捗行へ移してある。**要約行は skip を
    `SKIPPED [1] path/to/file.py:33: 理由` の形で出し、nodeid ではなくファイルと
    行番号を持つ（実測）。素直に読むと `[1]` が nodeid の位置に入り、その走行の
    skip が全部この1つの鍵へ潰れる。結果として skip されたケースが判定から消え、
    `skipif` を1つ足すだけで赤いテストが黙って緑になる。この道具が防ぐために
    在る型の失敗そのものなので、要約行は出典にしない。

    `--junit-xml` も採らない。`testcase` の `classname` は
    `deep.nested.dir.test_x.TestY` のようにディレクトリの区切りとモジュール名の
    ドットを同じ文字へ潰した形で、`file` 属性は付かない（実測）。nodeid の
    パスへ確実に戻す手段が無い。

    `-v` の進捗行は nodeid をそのまま持ち、skip も pass も同じ形で1行ずつ出る。
    """
    res = {}
    for ln in out.splitlines():
        s = ln.strip()
        m = PROGRESS_STRICT_RE.match(s) or PROGRESS_LOOSE_RE.match(s)
        if m:
            res[m.group("nodeid")] = m.group("outcome")
    return res


def evaluate(tree, extra_ro=(), collect_only=False):
    """1つのツリーを1回走らせて、判定に要るものを全部返す。

    R1（merge-base × merge-base のテスト）、R2（candidate × merge-base のテスト）、
    R3（candidate × candidate のテスト）の3回とも、この関数を通る。

    collect_only=True のときは収集で止める。--discover-only がこれを使う。
    走らせてしまうと `/morning` が毎朝両リポジトリの全件を回すことになり、
    「実行せず、discovery の検査と収集の差分だけを見る」という口の定義から外れる。
    """
    sandbox = make_sandbox_home()
    try:
        if not sandbox_started(tree, sandbox):
            return {"sandbox_ok": False}
        tracked = tracked_files(tree, sandbox)
        if tracked is None:
            return {"sandbox_ok": True, "ls_files_ok": False}
        py, sh = target_tests(tree, tracked)
        rc_collect, collected, _ = collected_files(tree, sandbox)
        missing, unexpected = collection_diff(tree, py, collected)
        out = {
            "sandbox_ok": True, "ls_files_ok": True,
            "tracked": tracked, "py": py, "sh": sh,
            "collected": collected, "rc_collect": rc_collect,
            "missing": missing, "unexpected": unexpected,
            "discovery": check_discovery_policy(tree),
            "results": {}, "rc_run": 0, "sh_green": 0, "sh_total": 0,
        }
        if collect_only:
            return out
        rc_run, run_out = run_python(tree, sandbox, ["--tb=no", "-v"], extra_ro)
        results = parse_pytest_outcomes(run_out)
        sh_rc = run_shell(tree, sandbox, sh, extra_ro)
        for rel, rc in sh_rc.items():
            results[rel] = "PASS" if rc == 0 else "FAIL"
        out.update({
            "results": results, "rc_run": rc_run,
            "sh_green": sum(1 for rc in sh_rc.values() if rc == 0),
            "sh_total": len(sh_rc),
        })
        return out
    finally:
        shutil.rmtree(sandbox, ignore_errors=True)


# 合否の語彙は2系統ある。pytest は PASSED / FAILED / ERROR / SKIPPED、
# shell レーンは PASS / FAIL。片方だけで照合すると、Python の赤が
# 既知の赤の格上げからも known-red の集計からも漏れる。
RED = {"FAIL", "FAILED", "ERROR"}
GREEN = {"PASS", "PASSED"}


def is_red(v):
    return v in RED


def regressions(base, cand):
    """base で赤くなく、candidate で赤くなったものを返す。

    red -> red は regression に算入しない。既知の赤と共存するため。
    base に無い（新しく足された）ものが赤い場合も返す。
    """
    out = []
    for key, val in sorted(cand.items()):
        if not is_red(val):
            continue
        # base で赤くなければ regression。緑からの悪化、base に無い新規、
        # skip からの悪化のいずれも拾う。**見逃すのは red -> red だけ。**
        # `base.get(key) in GREEN` で書くと、base が SKIPPED のものが
        # candidate で落ちても拾えない。自テストが skip を多用するので実害が出る。
        if not is_red(base.get(key)):
            out.append(key)
    return out


def disappeared(base, cand):
    """base で緑だったのに candidate では緑と言えなくなったものを返す。

    regression とは別の分類にする。**候補は「消えた」か「skip になった」で、
    赤くはない。**赤ければ regressions が拾う。ここが拾うのは、
    ケースが candidate の走行に現れなくなった場合（削除、deselect、
    読み込み時 skip）と、SKIPPED / XFAIL のように結果が緑でなくなった場合。

    regressions は candidate 側の鍵だけを回すので、この2つを原理的に見ない。
    分けずに regression へ混ぜると、正当な削除まで FAIL になる。受け入れ条件34b が
    「正当な削除は REVIEW」と定めているので、判定は REVIEW へ落とす。
    緑が消えたことは機械には正誤を決められないが、黙って通してよくもない。
    """
    out = []
    for key, val in sorted(base.items()):
        if val not in GREEN:
            continue
        now = cand.get(key)
        if now in GREEN or is_red(now):
            continue
        out.append(key)
    return out


def harness_failure_reasons(r, full=True):
    """検査そのものが成立しなかった理由を集める。引数は evaluate の戻り値。

    full=False のときは「走らせること自体ができなかった」3つだけを見る。
    R1 と R2 はこちらで呼ぶ。**導入の初回、merge-base には pyproject.toml も
    verify-tests も無い。**R1 にも構造の検査を当てると「pyproject.toml が
    ありません」が必ず立ち、判定が実行の門へ届かないまま FAIL を返す。
    pre-push は --strict を呼ぶので push も止まり、origin/main を進める手段が
    --no-verify だけになる。仕組みが自分で自分を塞ぐ。

    pytest の終了コードは0と1以外をすべてここへ落とす。
    2が収集エラー、3が内部エラー、4が使い方の誤り、5が収集0件。
    """
    if not r.get("sandbox_ok"):
        return ["bwrap の起動に失敗した"]
    if not r.get("ls_files_ok"):
        return ["git ls-files が失敗した"]
    reasons = []
    for name, rc in (("収集", r.get("rc_collect", 0)), ("本走行", r.get("rc_run", 0))):
        if rc not in (0, 1):
            reasons.append(f"{name}が終了コード {rc} を返した")
    if not full:
        return reasons
    for p in r.get("discovery", []):
        reasons.append(f"discovery policy: {p}")
    for m in r.get("missing", []):
        reasons.append(f"走らなかった: {m}")
    for u in r.get("unexpected", []):
        reasons.append(f"収集されたが候補に無い: {u}")
    return reasons


# 検証者そのもの。chezmoi を対象にするとき、これは candidate の中にある。
VERIFIER_SOURCE = "dot_local/private_bin/executable_verify-tests"


def trusted_artifacts(tracked):
    """次の base になりうるもの。テスト・検証者・discovery policy。

    検証者を含めるのは、実行の門では守れないため。実際に走るのは
    PATH 上の ~/.local/bin/verify-tests なので、ツリーの中のソースを
    ro-bind で被せても実行される実体は変わらない。昇格の門で受ける。
    """
    out = []
    for path in tracked:
        base = os.path.basename(path)
        if match_any(base, PY_PATTERNS) or match_any(base, SH_PATTERNS):
            out.append(path)
        elif base in ("pyproject.toml", "conftest.py", ".pre-commit-config.yaml"):
            out.append(path)
        elif path == VERIFIER_SOURCE:
            out.append(path)
    return sorted(out)


def trusted_overlay(base_tree, cand_tree, base_tracked):
    """base のテスト群を candidate のツリーの上へ読み取り専用で重ねる。

    --root も一時実行ツリーも overlay FS も要らない。bind mount が
    そのまま overlay の役割を果たし、実ファイルは変わらない（実測）。

    単位はファイル1つずつ。ディレクトリごと重ねると candidate の実装が
    base のもので隠れ、trust root が base を base で判定するだけになる。

    相対構造は bind 先のパスが保つ。重ねる先が candidate の中の同じパスなので、
    $HERE も $(dirname)/.. も同一ディレクトリからの import も、
    すべて candidate のツリーの中で解決される。
    """
    pairs = []
    for rel in trusted_artifacts(base_tracked):
        src = os.path.normpath(os.path.join(base_tree, rel))
        dst = os.path.normpath(os.path.join(cand_tree, rel))
        # 両方に実在するものだけを重ねる。candidate が削除またはリネームした
        # テストは dst が無く、bwrap は存在しないパスへ重ねようとすると
        # Read-only file system で rc=1 を返す（実測）。この値は pytest の
        # 「テストが落ちた」と同じなので、素直に渡すと正当な削除が
        # 機構の失敗へ落ちる。削除を捕まえるのは昇格の門の側。
        if os.path.isfile(src) and os.path.isfile(dst):
            pairs.append((src, dst))
    return pairs


def execution_gate(base_regressions, cand_regressions):
    """base のテストと candidate のテストを両方 candidate へ当てた結果を見る。"""
    base_ok = not base_regressions
    cand_ok = not cand_regressions
    if base_ok and cand_ok:
        return "PASS"
    if not base_ok and cand_ok:
        return "REVIEW"   # 契約変更の可能性。機械では意図を決められない
    return "FAIL"


def promotion_gate(repo, base_sha, base_tracked):
    """candidate の契約を次の base にしてよいかを別に見る。

    実行の門だけでは「実装は壊さず、次回から弱くする」を捕まえられない。
    今回の candidate が壊れていなくても、弱くなったテストが次の trust root になる。

    判定は byte-for-byte の同一性だけを使う。diff の見た目から
    「削除または弱める方向」を推測しない。
    """
    changed = []
    for rel in trusted_artifacts(base_tracked):
        out = subprocess.run(
            ["git", "-C", repo, "diff", "--quiet", base_sha, "--", rel],
            capture_output=True, text=True,
        )
        if out.returncode != 0:
            changed.append(rel)
    return changed


def touched_known_red(repo, base_sha, base_res, cand_res):
    """既知の赤とその対象を今回の patch が触ったか。

    無関係な作業を既知の赤で止めないための ratchet が、
    赤い領域を触った変更まで盲目的に通すのを防ぐ。

    対象実装の対応は命名規約で決める。推論はしない。当たらないものは
    テストファイル自身を触った場合だけ格上げの対象になる。
    """
    red_files = {k.split("::", 1)[0] for k, v in base_res.items() if is_red(v)}
    still_red_files = {k.split("::", 1)[0] for k, v in cand_res.items() if is_red(v)}
    out = subprocess.run(
        ["git", "-C", repo, "diff", "--name-only", base_sha],
        capture_output=True, text=True,
    )
    touched = {ln for ln in out.stdout.splitlines() if ln.strip()}

    escalate = []
    for test in sorted(red_files & still_red_files):
        # テスト自身を触ったか、命名規約で対応づく実装を触ったか。
        # 実装ファイルは cand_res に現れないので、交差ではなく
        # テストごとに「触られた集合」を作って判定する。
        related = {test} | implementation_of(test)
        if related & touched:
            escalate.append(test)
    return escalate


def implementation_of(test_path):
    """テストに対応する実装を命名規約だけで決める。

    規約に当たらないものは空を返す。推論しに行くと、外れたときに
    黙って通す側へ倒れる。
    """
    d = os.path.dirname(test_path)
    base = os.path.basename(test_path)
    cands = []
    if base.endswith(".test.sh"):
        stem = base[: -len(".test.sh")]
        cands.append(stem + ".sh")
        if stem.startswith("executable_"):
            # 接頭辞を落とした形も候補にする。`bash <path>` で呼ばれるフックは
            # 実行ビットが要らないので接頭辞を持たない。
            # executable_guard-unsandboxed-pytest.test.sh の本体は
            # guard-unsandboxed-pytest.sh で、接頭辞付きだけを見ると対応が付かない。
            cands.append(stem[len("executable_"):] + ".sh")
        else:
            cands.append("executable_" + stem + ".sh")
    elif base.startswith("test_") and base.endswith(".py"):
        cands.append(base[len("test_"):])
    elif base.startswith("test_") and base.endswith(".sh"):
        cands.append(base[len("test_"):])
    return {os.path.join(d, c) if d else c for c in cands}


def verdict(payload):
    """三値を決める唯一の場所。

    execution_gate は「base レーンと candidate レーンの差分」だけを見る。
    機構の失敗と本番への書き込みは、そこより先に立って FAIL を返す。
    優先順位は 機構の失敗 → 本番へ書いた → 実行の門 → 昇格の門 → 既知の赤
    → 緑が消えた。
    """
    if payload.get("harness_failed"):
        return "FAIL"
    if payload.get("wrote_production"):
        return "FAIL"
    gate = execution_gate(payload["base_regressions"], payload["cand_regressions"])
    if gate == "FAIL":
        return "FAIL"
    if gate == "REVIEW":
        return "REVIEW"
    if (payload.get("contract_changed") or payload.get("touched_red")
            or payload.get("disappeared")):
        return "REVIEW"
    return "PASS"


RESULT_PATH = os.path.expanduser("~/.cache/verify-tests/last-result.json")


def write_result(repo, verdict_value, counts):
    """判定結果を専用のファイルへ書く。

    Stop フックの入力には「直前に検証が成功した」を表す欄が無く、
    PostToolUse(Bash) の結果には数値の終了コードが記録されていない（実測）。
    使える経路は結果ファイル1つになる。
    突合しないと古い PASS で門を通せるので、作業ツリーの指紋を添える。
    """
    head = subprocess.run(["git", "-C", repo, "rev-parse", "HEAD"],
                          capture_output=True, text=True).stdout.strip()
    tree = current_tree(repo)   # index ではなく作業ツリーの指紋
    os.makedirs(os.path.dirname(RESULT_PATH), exist_ok=True)
    with open(RESULT_PATH, "w") as f:
        json.dump({
            "repo": repo, "head": head, "tree": tree,
            "verifier_version": VERSION, "verdict": verdict_value,
            "counts": counts,
        }, f)


def summarize(verdict_value, counts, details):
    """PASS のときは1行。FAIL と REVIEW のときだけ差分を返す。

    保証レベルも1行に含める。shell がファイル単位であることを
    読み手が知らないまま「緑だから安全」と受け取らないようにする。
    """
    if verdict_value == "PASS":
        names = ", ".join(os.path.basename(x) for x in counts["excluded"])
        ex = f" / 対象外 {names}" if counts["excluded"] else ""
        return (f"PASS  python={counts['py_cases']} "
                f"shell={counts['sh_green']}/{counts['sh_total']} green "
                f"+ {counts['known_red']} known-red unchanged "
                f"(shell はファイル単位 / Level 1{ex})")
    lines = [verdict_value]
    lines += [f"  {d}" for d in details]
    return "\n".join(lines)


ACCEPT_PATH = os.path.expanduser("~/.cache/verify-tests/accepted.json")


def current_tree(repo):
    """作業ツリーの指紋。

    `git write-tree` は index を見るので、未 stage の編集では値が変わらない
    （実測）。一方 promotion_gate と touched_known_red は `git diff <base>` を
    使うので作業ツリーを見る。承認だけ index に紐づけると、一度承認したあとに
    未 stage の編集をいくらでも重ねられ、毎回 REVIEW が PASS へ昇格する。
    判定と同じ側（作業ツリー）へ揃える。
    """
    import hashlib
    h = hashlib.sha256()
    for cmd in (["rev-parse", "HEAD"], ["diff", "HEAD"]):
        h.update(subprocess.run(["git", "-C", repo] + cmd,
                                capture_output=True, text=True).stdout.encode())
        h.update(b"\x00")
    # 追跡外ファイルは名前だけでなく中身まで入れる。git status --porcelain は
    # 名前しか出さず、git diff HEAD は追跡外を含まないので、名前だけだと
    # 追跡外テストの中身を書き換えても指紋が変わらない（実測で確認）。
    # pytest は追跡外のテストも収集するので、中身は検証結果を左右する入力。
    others = subprocess.run(
        ["git", "-C", repo, "ls-files", "--others", "--exclude-standard", "-z"],
        capture_output=True, text=True).stdout.split("\0")
    for rel in sorted(x for x in others if x):
        h.update(rel.encode() + b"\x00")
        try:
            with open(os.path.join(repo, rel), "rb") as f:
                h.update(f.read())
        except OSError:
            h.update(b"<unreadable>")
        h.update(b"\x00")
    return h.hexdigest()


def load_accepted(path):
    """受理記録を `{リポジトリ: レコード}` で返す。読めなければ空。

    旧形式（レコード1件を直に持つオブジェクト）もここで新形式へ寄せる。
    寄せずに捨てると、道具を更新した時点で有効だった受理が黙って外れる。
    """
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    if "repo" in data and "tree" in data:
        return {data["repo"]: data}
    return {k: v for k, v in data.items() if isinstance(v, dict)}


def store_accepted(path, repo, record):
    """1リポジトリ分の受理を、他のリポジトリの受理を消さずに書く。

    以前は単一のオブジェクトを丸ごと上書きしていたため、2つ目を受理した時点で
    1つ目が黙って `REVIEW` へ戻っていた。押した順序で結果が変わり、
    利用者からは「受理したはずなのに通らない」としか見えない（issue #29）。
    この道具は2つのリポジトリを対象にする設計なので、器も対象の数だけ要る。
    """
    recs = load_accepted(path)
    recs[repo] = record
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(recs, f)


def accept_review(repo, reason):
    """今のツリー1つに紐づく承認を書く。

    台帳にならない。承認は特定のツリーにしか効かず、将来の変更へ持ち越せない。
    ファイルを1バイトでも編集すればツリーが変わって外れる。
    """
    store_accepted(ACCEPT_PATH, repo,
                   {"repo": repo, "tree": current_tree(repo),
                    "verifier_version": VERSION, "reason": reason})


def accepted_for_current_tree(repo):
    rec = load_accepted(ACCEPT_PATH).get(repo)
    if not rec:
        return False
    return (rec.get("tree") == current_tree(repo)
            and rec.get("verifier_version") == VERSION)


# --- `--mutate` の起動、分類、報告 ---

# リポジトリ単位でしか出ない2つの分類。対象1つに当たることが無いので
# `classify_target` は返さない。
OUT_OF_SCOPE = "対象外"
NOT_RUNNABLE = "実行できなかった"

# 依存を固定した要求ファイル。**道具と同じ場所へ配る**（受け入れ条件8）。
# chezmoi のソースでは `dot_local/private_bin/` に道具と並べてある。名前を
# 書き起こすのはここ1箇所で、venv を作る命令もここから作る。
MUTATE_REQUIREMENTS = os.path.join(
    os.path.dirname(DEPLOYED_TOOL), "mutation-requirements.txt")

# Python レーンのセッション。**作業コピーの外へ置く。**中へ置くと sqlite が
# 作業コピーに現れ、リポジトリを走査する形のテストが原本と違うものを見る
# （`SHELL_MUTANT_ROOT` と同じ理由）。
PY_SESSION_NAME = "verify-tests-cosmic-ray.sqlite"

# sqlite が同じ場所へ書く連れのファイル。作り直す前に消す分。
PY_SESSION_SUFFIXES = ("", "-wal", "-shm")


def mutate_setup_hint(venv_path=MUTATE_VENV, req=MUTATE_REQUIREMENTS):
    """変異用の venv を作る命令を1行で返す（受け入れ条件42）。

    **要求ファイルを名指しする。**「uv pip install cosmic-ray universalmutator」
    と書くと、その場の最新版が入る。基準の生き残り集合は道具の版に依存するので、
    版の違う venv で作り直した基準は前の基準と比べられない。
    """
    return (f"uv venv {venv_path} && "
            f"uv pip install --python {venv_path}/bin/python -r {req}")


def _cosmic_ray(repo, sandbox, copy, args):
    """作業コピーの中で cosmic-ray を1回起動する。

    **PATH 解決に頼らない。**`python` が PATH に無いだけで全変異体が
    `INCOMPETENT` になった実例がある（`MUTATE_VENV` の注記）。
    """
    return _run_in_dir(repo, sandbox, copy,
                       [os.path.join(MUTATE_VENV, "bin", "cosmic-ray"), *args])


def python_lane_session(repo, sandbox, copy, config, conf):
    """cosmic-ray を1回まわし、`(init の件数, 変異なしの終了コード, dump)` を返す。

    **`init_count` は `cosmic-ray init` の直後の work item 数。**`dump` の行を
    数えて作る。`cr-filter-operators` の**後**の件数で作ってはいけない
    ——フィルタは work item を消さずに結果だけを書くので、後で数えると
    `python_lane_gate` の「`init` の件数 = 行 + 読み飛ばし」の照合が
    毎回発火するか、逆に何も見ないものになる。`init` の標準出力の解析でも
    作らない。書式が変われば黙って別の数になる。

    **設定はリポジトリ相対で渡す。**`cosmic-ray init` は設定に書かれたパスを
    cwd 基準で解決するので、絶対で渡すと `excluded-modules` のグロブが
    cwd 基準のままになり、門が数えた集合と実際に測る集合がずれる。

    **`unmutated_rc` は `test-command` そのものを走らせて取る。**`cosmic-ray
    baseline` の終了コードを渡さない。あれは `test-command` が起動できなくても
    0 を返す（実測）。
    """
    host = os.path.join(sandbox, PY_SESSION_NAME)
    for suffix in PY_SESSION_SUFFIXES:
        if os.path.exists(host + suffix):
            os.remove(host + suffix)
    session = inside_home(PY_SESSION_NAME)

    rc, out, err = _cosmic_ray(repo, sandbox, copy, ["init", config, session])
    if rc != 0:
        raise Unmeasurable(
            f"cosmic-ray init が失敗した（rc={rc}）{_tail(err or out)}")
    rc, out, err = _cosmic_ray(repo, sandbox, copy, ["dump", session])
    if rc != 0:
        raise Unmeasurable(
            f"cosmic-ray dump が失敗した（rc={rc}）{_tail(err or out)}")
    init_count = len([ln for ln in out.splitlines() if ln.strip()])

    # **設定がフィルタを宣言しているときだけ走らせる。**宣言を見ずに走らせると、
    # フィルタの設定を持たないリポジトリで cr-filter-operators が落ちて原因の
    # 読めない失敗になる。宣言があるのに走らせないと、除外したはずの演算子が
    # そのまま測定へ流れ込む。
    if (conf.get("filters") or {}).get("operators-filter"):
        rc, out, err = _run_in_dir(
            repo, sandbox, copy,
            [os.path.join(MUTATE_VENV, "bin", "cr-filter-operators"),
             session, config])
        if rc != 0:
            raise Unmeasurable(
                f"cr-filter-operators が失敗した（rc={rc}）{_tail(err or out)}")

    command = conf.get("test-command")
    if not isinstance(command, str) or not command.strip():
        raise Unmeasurable(f"{config}: `test-command` が空")
    try:
        argv = shlex.split(command)
    except ValueError as e:
        raise Unmeasurable(f"{config}: `test-command` を語に割れない（{e}）")
    if not argv:
        raise Unmeasurable(f"{config}: `test-command` が語を1つも持たない")
    # **cosmic-ray と同じ起動の仕方で走らせる。**`run_tests` は `shlex.split` して
    # Popen へ渡すだけで shell を通さない（`cosmic_ray/testing.py`、実測）。
    # `bash -c` で包むと、包んだせいで通る／落ちるという差がここだけに出る。
    unmutated_rc, _, _ = _run_in_dir(repo, sandbox, copy, argv)

    rc, out, err = _cosmic_ray(repo, sandbox, copy, ["exec", config, session])
    if rc != 0:
        raise Unmeasurable(
            f"cosmic-ray exec が失敗した（rc={rc}）{_tail(err or out)}")
    rc, dump, err = _cosmic_ray(repo, sandbox, copy, ["dump", session])
    if rc != 0:
        raise Unmeasurable(
            f"cosmic-ray dump が失敗した（rc={rc}）{_tail(err or dump)}")
    return init_count, unmutated_rc, dump


def blank_lane():
    """レーン1つ分の入れ物。**測れた対象すべてに3つの記録が揃う形で返す。**

    - `targets` / `survivors` / `excluded` / `unmeasurable` … 走行の結果へそのまま入る
    - `stats` … 対象ごとの件数（報告だけに使う）
    - `blocked` … レーン全体が立ち上がらなかった理由。対象の一覧すら決まらない
      ときだけ。決まるなら対象ごとの `unmeasurable` へ落とす
    - `notes` … 判定には効かないが報告へ出す行
    """
    return {"targets": [], "survivors": {}, "excluded": {}, "unmeasurable": [],
            "stats": {}, "blocked": None, "notes": []}


def run_python_lane(repo, sandbox, copy):
    """Python レーンを1セッション回し、`blank_lane` の形で返す。

    **リポジトリ単位で1セッション。**cosmic-ray のセッションが設定1つに対して
    1つなので、粒度をそちらへ合わせる。門が止めるときは Python 対象がまとめて
    「計測できなかった」へ落ちる。

    **ループを `mutate_main` へ畳まない。**畳むと、本番資産の前後比較が変異体
    ごとに行われていないこと（受け入れ条件40）を見る検査が `mutate_main` の
    一語に潰れ、実際に変異体ごとに取っていても素通りする（`run_shell_lane` と
    同じ理由）。
    """
    out = blank_lane()
    try:
        config, conf = mutation_config(repo)
        known = sorted(py_target_set(repo, sandbox))
    except Unmeasurable as e:
        # 対象の一覧そのものが決まらない。対象ごとに落とせないのでレーンごと。
        out["blocked"] = f"Python レーン: {e}"
        return out
    if not known:
        out["blocked"] = (
            "Python レーン: 対象の `.py` が1本も無い"
            "（`module-path` と `excluded-modules` を見る）")
        return out
    try:
        init_count, unmutated_rc, dump = python_lane_session(
            repo, sandbox, copy, config, conf)
        reason = python_lane_gate(dump, init_count, unmutated_rc)
        if reason is not None:
            raise Unmeasurable(reason)
        rows, _skipped, timeouts = ids_from_cosmic_ray(dump)
    except Unmeasurable as e:
        # **対象ごとに落とす。**原因は1セッションぶん共通だが、分類も
        # `--update-baseline` の単位も対象なので、粒度をそちらへ揃える。
        out["unmeasurable"] = [(t, f"{t}: {e}") for t in known]
        return out
    got = group_by_target(rows)
    seen = {}
    for row in rows:
        seen[row[0][0]] = seen.get(row[0][0], 0) + 1
    out["targets"] = list(got["targets"])
    out["survivors"] = {t: list(got["survivors"][t]) for t in got["targets"]}
    out["unmeasurable"] = list(got["unmeasurable"])
    # **Python レーンには構文検査の前段が無い。**shell レーンの `excluded` は
    # 生成した変異体を `bash -n` と `ast.parse` に掛けて落とした分で、cosmic-ray は
    # 構文の壊れた変異体をそもそも作らない。ここの 0 は「渡し忘れ」ではなく
    # 「その段が無い」ことの記録である。**`.get(t, 0)` で後から埋めさせない**
    # ために、レーンの側で対象ごとに明示して置く。
    out["excluded"] = {t: [] for t in got["targets"]}
    for t in got["targets"]:
        # **kill 数と生き残り数はここに持たない。**報告は `survivors_for` を
        # 通した件数から導く（`STATS_KEYS` の注記）。
        out["stats"][t] = {"mutants": seen[t], "excluded": 0,
                           "analyzed": seen[t], "timeouts": timeouts[t]}
    # 変異体が1件も出なかった対象。**止めない**（門の粒度をセッション単位から
    # 対象単位へ変えるのは spec の変更にあたる）が、黙って落とさない。
    # 「測っていない」を静かに通さないための行。
    silent = sorted(set(known) - set(got["targets"])
                    - {t for t, _ in got["unmeasurable"]})
    if silent:
        out["notes"].append(
            "変異体が1件も出なかった Python 対象: " + "、".join(silent))
    return out


def shell_lane_result(rows):
    """`run_shell_lane` の対象ごとの成績を `blank_lane` の形へ移す。

    **測れた対象には `survivors` と `excluded` を必ず両方置く。**片方でも
    欠けたまま渡すと `survivors_for` / `filtered_counts_for` が止める。止める形に
    してあるのは、空や 0 で埋めた対象へ満点が焼き付くのを防ぐため。ここで
    埋めずに、記録の欠けた対象は「計測できなかった」へ落とす。
    """
    out = blank_lane()
    for target in sorted(rows):
        row = rows[target]
        if row["unmeasurable"] is not None:
            out["unmeasurable"].append((target, row["unmeasurable"]))
            continue
        lacking = [k for k in ("mutants", "excluded", "analyzed", "killed",
                               "survivors", "timeouts") if row[k] is None]
        if lacking:
            out["unmeasurable"].append(
                (target, f"{target}: 測れたはずの対象に記録が無い"
                         f"（{'、'.join(lacking)}）"))
            continue
        out["targets"].append(target)
        out["survivors"][target] = [tuple(k) for k in row["survivors"]]
        out["excluded"][target] = [tuple(k) for k in row["excluded"]]
        # `killed` と `survivors` はここに持たない（`STATS_KEYS` の注記）。
        # レーンは `killed + notkilled == kept` を門で確かめてから返すので、
        # `analyzed - 生き残り` と一致する。一致するなら持つ理由が無い。
        out["stats"][target] = {
            "mutants": row["mutants"], "excluded": len(row["excluded"]),
            "analyzed": row["analyzed"], "timeouts": row["timeouts"]}
    return out


def merge_lanes(lanes):
    """レーンの結果を合併し、`(走行の結果, 成績, 立ち上がらなかった理由, 注記)`。

    **同じ対象が2つのレーンに現れたら止める。**Python レーンは `.py` を、
    shell レーンは宣言先を測るので現状は重ならないが、重なったときにどちらの
    成績を採るかを黙って決めると、採らなかった側の記録が消える。
    """
    targets, survivors, excluded, bad = [], {}, {}, []
    stats, blocked, notes = {}, [], []
    for lane in lanes:
        clash = sorted(set(lane["targets"]) & set(targets))
        if clash:
            raise BaselineBroken(
                f"同じ対象が2つのレーンに現れた（{'、'.join(clash)}）。"
                "どちらの成績を採るかを決められない")
        targets += list(lane["targets"])
        survivors.update(lane["survivors"])
        excluded.update(lane["excluded"])
        stats.update(lane["stats"])
        bad += list(lane["unmeasurable"])
        notes += list(lane["notes"])
        if lane["blocked"]:
            blocked.append(lane["blocked"])
    current = {"targets": sorted(targets), "survivors": survivors,
               "excluded": excluded, "unmeasurable": bad}
    return current, stats, blocked, notes


# 成績が持つ鍵。**kill 数と生き残り数を持たない。**どちらも
# 「測定した件数」と「生き残りの集合の大きさ」から決まる。レーンの側で数え直すと、
# 報告が読む件数と判定が読む集合が別経路になり、**食い違ったときに成績の行だけが
# 嘘をつき、判定は正しいまま**になる。生き残りの件数は `survivors_for` を通した
# ものだけを使う（`compare` や `store_baseline` が読むのと同じ門）。
STATS_KEYS = ("mutants", "excluded", "analyzed", "timeouts")


def score_line(target, s, alive):
    """対象1つの成績の行（受け入れ条件23）。

    `alive` は `survivors_for` が返した、その対象の生き残りの識別子。
    **件数をここで数え直さない。**判定が使う集合そのものから導く。

    **生存率は併記するだけで判定には使わない。**等価ミュータントが率の上で
    永久に生存側へ計上され続けるので、閾値を運用すると緩めた幅の中に本物の
    劣化が隠れる。判定は生き残りの集合の差分で行う。

    **タイムアウト由来の kill を別に出す。**両方の道具がタイムアウトを kill に
    数えるので、出さないと「テストが判別した」と「テストが遅かった」が成績の
    上で同じ顔をする。
    """
    lacking = [k for k in STATS_KEYS if k not in s]
    if lacking:
        raise BaselineBroken(
            f"{target}: 成績の記録が足りない（{'、'.join(lacking)}）")
    analyzed = s["analyzed"]
    survivors = len(alive)
    rate = ("—" if analyzed == 0
            else f"{100.0 * survivors / analyzed:.1f}%")
    return (f"  {target}  変異体 {s['mutants']}"
            f"（構文検査で除外 {s['excluded']} / 測定 {analyzed}）"
            f"  kill {analyzed - survivors}  生き残り {survivors}"
            f"  生存率 {rate}  タイムアウト由来の kill {s['timeouts']}")


def mutate_report(current, stats, base, tools, diff, labels, failed,
                  unmeasured_rows, notes, blocked):
    """`--mutate` の報告の行。**0件でも見出しを出す。**

    黙って省くと、該当が無かったのか報告の側が落としたのかを読む人が区別
    できない（`update_report` と同じ流儀）。**最も重い理由をこの流儀の外に
    置かない。**レーンが丸ごと立ち上がらなかったことと、走行が本番資産へ
    書いたことは `blocked` に載る。見出しの無い裸の行として末尾へ流すと、
    「計測できなかった対象: 0件」と「分類: 計測できなかった」が並ぶ報告になる。
    """
    # **生き残りの集合を先に作る。**成績の行がここから件数を取る。
    alive = survivors_for(current)

    lines = ["-- 対象ごとの成績 --"]
    lines += [score_line(t, stats[t], alive[t]) for t in current["targets"]]
    if not current["targets"]:
        lines.append("  （測れた対象なし）")

    # 受け入れ条件24。**パスと行番号と変異後の行の内容で出す。**
    total = sum(len(v) for v in alive.values())
    lines.append(f"-- 生き残った変異体: {total}件 --")
    for t in current["targets"]:
        for path, line, content in alive[t]:
            lines.append(f"  {path}:{line}: {content}")

    lines.append(f"-- レーンが立ち上がらなかった: {len(blocked)}件 --")
    lines += [f"  {why}" for why in blocked]

    lines.append(f"-- 計測できなかった対象: {len(current['unmeasurable'])}件 --")
    lines += [f"  {reason}" for _t, reason in sorted(current["unmeasurable"])]

    # 受け入れ条件12。
    lines.append(f"-- 測っていない対象: {len(unmeasured_rows)}件 --")
    lines += [f"  {p} — {why}" for p, why in unmeasured_rows]

    # 受け入れ条件34。**2種類とも出す。**片方だけ出すと「除外はこれだけ」に見える。
    report = excluded_report(base)
    lines.append(f"-- 判定から外した変異体（非決定）: {report['count']}件 --")
    lines += [f"  {ln}" for ln in report["lines"]]
    lines.append(
        f"-- 構文検査が落とした変異体（基準）: {report['filtered_total']}件 --")

    drift = compare_filtered(base, current)
    lines.append(f"-- 構文検査による除外の件数が基準と違う対象: {len(drift)}件 --")
    lines += [f"  {t}: 基準 {was} → 今回 {now}"
              for t, (was, now) in sorted(drift.items())]

    tdrift = tool_drift(base, tools)
    lines.append(f"-- 道具の版が基準と違う: {len(tdrift)}件 --")
    lines += [f"  {name}: 基準 {was} → 今回 {now}" for name, was, now in tdrift]
    lines.append("  版が違う走行で差分が出ても、判別力が落ちたとは読めない"
                 if tdrift else "  今回の版: "
                 + "、".join(f"{n} {tools[n]}" for n in sorted(tools)))

    lines.append(f"-- 基準に無い生き残り: {sum(len(v) for v in diff.values())}件 --")
    for t in sorted(diff):
        for path, line, content in diff[t]:
            lines.append(f"  {path}:{line}: {content}")

    lines.append("-- 対象ごとの分類 --")
    for t in sorted(labels):
        if labels[t] != NO_FINDING:
            lines.append(f"  {labels[t]}: {t}")
    for t in sorted(failed):
        lines.append(f"  {UNMEASURABLE}: {failed[t]}")
    lines += [f"== {n}" for n in notes]
    return lines


def mutate_verdict(labels, failed, blocked):
    """`--mutate` のリポジトリ単位の分類と終了コード。

    優先順位は「計測できなかった」「判別力が落ちた」「基準が無い」。上に立つ
    「対象外」と「実行できなかった」はここより手前で決まる。

    **分類の値を正の形で数え上げる。**「知っている分類以外は無害」と書くと、
    分類が1つ増えたときに黙って所見なしの側へ落ちる。
    """
    unknown = sorted(set(labels.values())
                     - {UNMEASURABLE, REGRESSED, NO_BASELINE, NO_FINDING})
    if unknown:
        raise BaselineBroken(f"知らない分類がある（{'、'.join(unknown)}）")
    if blocked or failed or UNMEASURABLE in labels.values():
        return UNMEASURABLE, 1
    if REGRESSED in labels.values():
        return REGRESSED, 1
    if NO_BASELINE in labels.values():
        return NO_BASELINE, 1
    return NO_FINDING, 0


def mutate_run(repo, sandbox):
    """両レーンを走らせ、`(走行の結果, 成績, 止まった理由, 注記, 測っていない対象)`。

    **完全性の門を走行の前に見る。**`module-path` の手書きの一覧に無い
    ディレクトリへ置かれた `.py` は、名指しの一覧と同じように黙って対象外に
    なる。1本でもあれば「計測できなかった」で止める（受け入れ条件5）。
    """
    copy = make_worktree_copy(repo, sandbox)
    if copy is None:
        return None, {}, ["作業コピーを作れなかった"], [], []
    tracked = tracked_files(repo, sandbox)
    if tracked is None:
        return None, {}, ["git ls-files が失敗した"], [], []
    rows = unmeasured(repo, tracked)
    try:
        gap = completeness_gap(repo, sandbox)
    except Unmeasurable as e:
        return None, {}, [str(e)], [], rows
    if gap:
        return None, {}, ["対象にも除外にも属さない追跡 `.py` がある: "
                          + "、".join(sorted(gap))], [], rows
    py = run_python_lane(repo, sandbox, copy)
    pairs = shell_pairs(repo, tracked)
    sh = shell_lane_result(run_shell_lane(repo, sandbox, pairs["pairs"]))
    # 宣言を読めなかったテストも「計測できなかった」に載せる。載せないと、
    # 宣言を1本消しただけでその対象が網から静かに消える（受け入れ条件13・14）。
    sh["unmeasurable"] += list(pairs["unmeasurable"])
    current, stats, blocked, notes = merge_lanes([py, sh])
    return current, stats, blocked, notes, rows


def mutate_main(repo, argv):
    """`verify-tests <repo> --mutate`。**既定で非0を返す。**

    分類の優先順位は「対象外」「実行できなかった」「計測できなかった」
    「判別力が落ちた」「基準が無い」。先の2つは `main` とここの入口で決まる
    （「対象外」は隔離を組む手前、「実行できなかった」は bwrap と venv の有無）。
    """
    # **効かない指定を黙って無視しない。**無視すると、打った人には効いたように
    # 見える。`--strict` は `--mutate` が既定で非0を返すので要らず、`--` と
    # `--discover-only` は変異の走行に当たる意味を持たない。
    misused = [f for f in ("--strict", "--", "--discover-only") if f in argv]
    if misused:
        print(f"{NOT_RUNNABLE}: --mutate は {' / '.join(misused)} と併用できません。"
              "--mutate は所見が1つでもあれば既定で非0を返すので --strict が要らない")
        return 1
    try:
        tools = mutation_tool_versions()
    except Unmeasurable as e:
        # 「実行できなかった」。venv も道具も無ければそもそも測れていない。
        # **`--update-baseline` を付けても非0のまま。**壊れた計測結果を基準として
        # 書き込まないため。
        print(f"{NOT_RUNNABLE}: {e}")
        print(f"  作る: {mutate_setup_hint()}")
        return 1
    before = snapshot_watched()
    sandbox = make_sandbox_home()
    try:
        current, stats, blocked, notes, rows = mutate_run(repo, sandbox)
    except BaselineBroken as e:
        # `merge_lanes` が投げうる（対象が2つのレーンに現れた場合）。現状は
        # 到達しないが、**到達したときに素の traceback にしない。**
        current, stats, blocked, notes, rows = None, {}, [str(e)], [], []
    finally:
        shutil.rmtree(sandbox, ignore_errors=True)
    # 本番資産の前後比較は走行ごとに1回（受け入れ条件40）。変異体ごとではない。
    if watched_report(before):
        blocked = list(blocked) + ["走行が本番資産へ書いた（上の行を見る）"]
    if current is None:
        # 走行の入れ物すら組み立てられていないので、報告の他の節は出せない。
        # **見出しと件数は同じ流儀で出す。**
        print(f"{UNMEASURABLE}: 走行を組み立てられなかった")
        print(f"-- レーンが立ち上がらなかった: {len(blocked)}件 --")
        for why in blocked:
            print(f"  {why}")
        print(f"-- 測っていない対象: {len(rows)}件 --")
        for path_, why in rows:
            print(f"  {path_} — {why}")
        return 1
    current["tools"] = tools

    path = baseline_path(repo)
    try:
        base = load_baseline(path)
        labels, failed, diff = classify_targets(base, current)
        for ln in mutate_report(current, stats, base, tools, diff,
                                labels, failed, rows, notes, blocked):
            print(ln)
        if "--update-baseline" in argv:
            if blocked:
                # 立ち上がらなかった走行の結果で基準を書き換えない。
                # 理由は上の節が既に1件1行で出している。
                print(f"{UNMEASURABLE}: 基準を書かない")
                return 1
            written, skipped = update_baseline(path, current)
            for ln in update_report(current, written, skipped):
                print(ln)
            label, code = update_verdict(skipped)
            print(f"分類: {label}")
            return code
        label, code = mutate_verdict(labels, failed, blocked)
    except BaselineBroken as e:
        # **「計測できなかった」へ落とす。**基準の入れ物が壊れているので、
        # 今回の成績を基準と比べられていない。5分類のうちこれが最も近い。
        print(f"{UNMEASURABLE}: {e}")
        return 1
    print(f"分類: {label}")
    return code


USAGE = [
    "使い方: verify-tests <リポジトリ> [--strict] [--discover-only]"
    " [--mutate [--update-baseline]] [--accept-review <理由>]"
    " [-- <pytest への引数>]",
    "--mutate は所見が1つでもあれば非0を返す（既定）。"
    "/morning からも pre-push からも呼ばないので、"
    "止める側に倒しても他の報告を巻き添えにしない。--strict は取らない",
]


def main(argv):
    if "--help" in argv:
        for ln in USAGE:
            print(ln)
        return 0

    if "--selftest-verdict" in argv:
        i = argv.index("--selftest-verdict")
        print(verdict(ast.literal_eval(argv[i + 1])))
        return 0

    if "--selftest-regressions" in argv:
        i = argv.index("--selftest-regressions")
        base, cand = ast.literal_eval(argv[i + 1])
        print(regressions(base, cand))
        return 0

    if "--selftest-disappeared" in argv:
        i = argv.index("--selftest-disappeared")
        base, cand = ast.literal_eval(argv[i + 1])
        print(disappeared(base, cand))
        return 0

    if "--selftest-parse" in argv:
        # pytest の出力そのものを渡して、鍵と値の対応を確かめる口。
        # skip が nodeid で入ることは、この道具の存在理由に直結するので、
        # 実装の中だけで閉じずに外から検査できるようにする。
        i = argv.index("--selftest-parse")
        print(json.dumps(parse_pytest_outcomes(argv[i + 1]), sort_keys=True))
        return 0

    if "--selftest-normalize" in argv:
        i = argv.index("--selftest-normalize")
        print(normalize(argv[i + 1]))
        return 0

    if "--selftest-accept-store" in argv:
        # 受理記録の入れ物だけを、渡されたパスの上で確かめる口。
        # 本番の ACCEPT_PATH には触れない。受理が互いを消さないことは
        # 実装の中だけで閉じずに外から検査できるようにする（issue #29）。
        i = argv.index("--selftest-accept-store")
        path, ops = ast.literal_eval(argv[i + 1])
        for repo, rec in ops:
            store_accepted(path, repo, rec)
        print(json.dumps(load_accepted(path), sort_keys=True))
        return 0

    if "--selftest-baseline-path" in argv:
        # 基準ファイルの置き場だけを外から叩く口。読み書きはしない。
        i = argv.index("--selftest-baseline-path")
        print(baseline_path(argv[i + 1]))
        return 0

    if "--selftest-baseline-store" in argv:
        # 基準の入れ物だけを、渡されたパスの上で確かめる口。
        # **本番の `.mutation-baseline.json` には触れない**（`--selftest-accept-store`
        # と同じ形）。`(path, [(current, tools), ...])` を渡すと、その順で書いて
        # 最後に読み直した基準を返す。初期の中身はテスト側が先に書いておく。
        i = argv.index("--selftest-baseline-store")
        path, ops = ast.literal_eval(argv[i + 1])
        try:
            base = load_baseline(path)
            for current, tools in ops:
                base = store_baseline(path, current, tools)
            payload = {"baseline": baseline_document(base), "error": None}
        except BaselineBroken as e:
            payload = {"baseline": None, "error": str(e)}
        print(json.dumps(payload, sort_keys=True, ensure_ascii=False))
        return 0

    if "--selftest-baseline-update" in argv:
        # `--update-baseline` の書き込みだけを、渡されたパスの上で叩く口。
        # **本番の `.mutation-baseline.json` には触れない。**`(path, results)` を
        # 渡すと、書いた対象・書かなかった対象・報告の行・リポジトリ単位の分類と
        # 終了コード・書き直した基準を返す。**`--mutate` への配線は Task 12。**
        i = argv.index("--selftest-baseline-update")
        path, results = ast.literal_eval(argv[i + 1])
        try:
            written, skipped = update_baseline(path, results)
            label, code = update_verdict(skipped)
            payload = {"written": written, "skipped": skipped,
                       "report": update_report(results, written, skipped),
                       "classification": label, "exit_code": code,
                       "baseline": baseline_document(load_baseline(path)),
                       "error": None}
        except BaselineBroken as e:
            payload = {"written": None, "skipped": None, "report": None,
                       "classification": None, "exit_code": None,
                       "baseline": None, "error": str(e)}
        print(json.dumps(payload, sort_keys=True, ensure_ascii=False))
        return 0

    if "--selftest-baseline-compare" in argv:
        # 比較と分類だけを、渡されたパスの基準の上で叩く口。書き込みはしない。
        # `(path, current, tools, classify_targets)` を渡す。`classify_targets` に
        # `None` を渡すと今回の走行に出てきた対象すべてを分類する。明示できる形に
        # したのは、**走行に無い対象を渡したときに止まる**ことを外から撃つため。
        i = argv.index("--selftest-baseline-compare")
        path, current, tools, wanted = ast.literal_eval(argv[i + 1])
        try:
            base = load_baseline(path)
            # **`classify_targets` を通す。**独自に回すと、`compare` を1回に
            # まとめる形も、基準側を合併する一覧も、この口の中だけで別に書かれる。
            labels, failed, diff = classify_targets(base, current)
            if wanted is not None:
                # 明示の一覧は「走行に無い対象を渡したときに止まる」ことを外から
                # 撃つためのもの。合併された一覧の上から、渡された分だけを取り直す。
                labels, failed = {}, {}
                for t in wanted:
                    try:
                        labels[t] = classify_target(base, current, t, diff)
                    except ValueError as e:
                        failed[t] = str(e)
            payload = {
                "baseline": baseline_document(base),
                "compare": {t: [list(k) for k in v] for t, v in diff.items()},
                "filtered_drift": {t: list(v) for t, v
                                   in compare_filtered(base, current).items()},
                "excluded_report": excluded_report(base),
                "classify": labels,
                "classify_error": failed,
                "tool_drift": [list(row) for row in tool_drift(base, tools or {})],
                "error": None,
            }
        except BaselineBroken as e:
            payload = {"baseline": None, "compare": None,
                       "filtered_drift": None, "excluded_report": None,
                       "classify": None, "classify_error": None,
                       "tool_drift": None, "error": str(e)}
        print(json.dumps(payload, sort_keys=True, ensure_ascii=False))
        return 0

    if "--selftest-tool-versions" in argv:
        # 基準へ焼く版を実物の venv から読む口。**引数を省くと既定を使う**
        # （`--selftest-mutate-binds` と同じ形）。
        i = argv.index("--selftest-tool-versions")
        rest = argv[i + 1:]
        try:
            got = (mutation_tool_versions(rest[0]) if rest
                   else mutation_tool_versions())
            payload = {"tools": got, "unmeasurable": None}
        except Unmeasurable as e:
            payload = {"tools": None, "unmeasurable": f"{UNMEASURABLE}: {e}"}
        print(json.dumps(payload, sort_keys=True, ensure_ascii=False))
        return 0

    if "--selftest-mutate-binds" in argv:
        # venv の追加 bind の作り方だけを外から確かめる口。実在するパスを
        # 渡せば対を、無いパスを渡せば空を返す。
        # **引数を省くと既定（MUTATE_VENV）を使う。**省けるようにしてあるのは、
        # 既定が絶対パスであることを外から見る手段がこれしか無いため。
        # 渡したパスだけを検査すると、渡す側が絶対パスを作っているだけの
        # 検査になり、道具が PATH 解決へ寄せ替えられても素通りする。
        i = argv.index("--selftest-mutate-binds")
        print(json.dumps(mutate_binds(*argv[i + 1:i + 2])))
        return 0

    if "--selftest-worktree-copy" in argv:
        # 作業コピーが追跡ファイルだけから作られることを外から確かめる口。
        # ホスト側の実体を歩いて、中身と権限をそのまま返す。
        i = argv.index("--selftest-worktree-copy")
        tree = os.path.abspath(argv[i + 1])
        sandbox = make_sandbox_home()
        try:
            copy = make_worktree_copy(tree, sandbox)
            host = os.path.join(sandbox, WORKTREE_COPY_NAME)
            files, modes = [], {}
            for root, _, names in os.walk(host):
                for n in names:
                    p = os.path.join(root, n)
                    rel = os.path.relpath(p, host)
                    files.append(rel)
                    modes[rel] = oct(os.stat(p).st_mode & 0o777)
            print(json.dumps({
                "copy": copy, "files": sorted(files), "modes": modes,
                "tracked": sorted(tracked_files(tree, sandbox) or []),
            }, sort_keys=True))
            return 0
        finally:
            shutil.rmtree(sandbox, ignore_errors=True)

    if "--selftest-worktree-run" in argv:
        # 作業コピーの中で1つのコマンドを走らせ、書き込みがどこへ落ちたかを返す口。
        # 変異体そのものを呼び出し側が書けるようにする。何を「変異体らしい書き込み」
