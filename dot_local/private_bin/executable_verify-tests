    os.path.expanduser("~/.local/share/chezmoi/dot_claude/private_settings.json"),
]

PY_PATTERNS = (r"^test_.*\.py$", r"^.*_test\.py$")
SH_PATTERNS = (r"^.*\.test\.sh$", r"^test_.*\.sh$")

# v1 の対象から外す本。#20 が閉じるまで隔離下の本来の挙動を測れず、
# normal / broken のどちらでも rc=1 のままになる。
SHELL_EXCLUDED = {"dot_claude/compact-plus-backend/executable_e2e-integration.test.sh"}


def normalize(url):
    """origin の URL を <所有者>/<リポジトリ名> へ揃える。

    表記が1文字違うだけで「対象外」に落ち、何も検査せずに通るので、
    ここを省くと issue #15 の型をこの道具自身が作る。
    """
    s = re.sub(r"^[a-z][a-z0-9+.-]*://", "", url)
    s = re.sub(r"^[^@/]*@", "", s)
    s = re.sub(r"^[^/:]+[:/]", "", s)
    s = re.sub(r"\.git$", "", s)
    return s.rstrip("/")


def origin_of(repo):
    out = subprocess.run(
        ["git", "-C", repo, "remote", "get-url", "origin"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        return None
    return out.stdout.strip()


def in_scope(repo):
    url = origin_of(repo)
    if url is None:
        return False
    return normalize(url) in SCOPE


def git_common_dir(repo):
    """ワークツリーの場合はメイン側の .git を返す。

    --path-format=absolute を省くと非ワークツリーで相対パスが返り、
    bind に使えない。
    """
    out = subprocess.run(
        ["git", "-C", repo, "rev-parse", "--path-format=absolute",
         "--git-common-dir"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        return None
    return out.stdout.strip()


def match_any(basename, patterns):
    return any(re.match(p, basename) for p in patterns)


def target_tests(repo, tracked):
    """追跡ファイルの一覧から Python と shell の対象を選ぶ。

    規則は basename へ当てる。パス全体への部分一致にすると
    diet/scripts/latest_report.py のような無関係なファイルを拾う。
    """
    py, sh = [], []
    for path in tracked:
        base = os.path.basename(path)
        if match_any(base, PY_PATTERNS):
            py.append(path)
        elif match_any(base, SH_PATTERNS) and path not in SHELL_EXCLUDED:
            sh.append(path)
    return sorted(py), sorted(sh)


# penguinEx の pyproject.toml が持つべき norecursedirs。
# 既定値から .* だけを外し、残りは引き継いでいる。
EXPECTED_NORECURSEDIRS = [
    "*.egg", "_darcs", "build", "CVS", "dist", "node_modules", "venv", "{arch}",
    "__pycache__", ".git", ".worktrees", "worktrees", ".venv", ".pytest_cache",
    ".superpowers", ".github",
]


def check_discovery_policy(repo):
    """設定の内容そのものを検査する。

    期待値を「テストの一覧」ではなく「設定の内容」に持つので腐敗しない。
    台帳を持つ道を避けたのはこのため。
    """
    import tomllib
    path = os.path.join(repo, "pyproject.toml")
    if not os.path.exists(path):
        return ["pyproject.toml がありません"]
    with open(path, "rb") as f:
        conf = tomllib.load(f)
    opts = conf.get("tool", {}).get("pytest", {}).get("ini_options", {})
    problems = []
    if "norecursedirs" in opts:
        got = list(opts["norecursedirs"])
        if got != EXPECTED_NORECURSEDIRS:
            missing = [d for d in EXPECTED_NORECURSEDIRS if d not in got]
            extra = [d for d in got if d not in EXPECTED_NORECURSEDIRS]
            problems.append(
                f"norecursedirs が期待値と違います（不足 {missing} / 余分 {extra}）"
            )
    elif "testpaths" not in opts:
        problems.append("norecursedirs も testpaths もありません")
    return problems


def collection_diff(repo, py_targets, collected):
    """候補と収集結果を両方向で突き合わせる。

    片方向だけだと、ワークツリーの混入や gitignore された場所に置かれた
    test_*.py のように逆向きでしか見えない事故を見逃す。
    """
    want = {os.path.normpath(os.path.join(repo, p)) for p in py_targets}
    return sorted(want - collected), sorted(collected - want)


SANDBOX_PREFIX = "verify-tests-sandbox."
MARKER = "/tmp/.verify-tests-marker"

# サンドボックスの HOME に作る合成フィクスチャ。
# test_memory_recall.py が memory ディレクトリの「実在」を見るため、
# ro-bind では埋まらない（実測）。本番の memory は見せない。
# 名前は任意ではない。test_memory_recall.py の67行目がこの文字列を
# 字面で持っている（実測で確認）。別の名前にすると実在チェックが通らない。
FIXTURE_PROJECT = "-home-yagu001-repo-github-com-haoblackj-penguinEx"


def bwrap_available():
    return shutil.which("bwrap") is not None


def make_sandbox_home():
    """使い捨ての HOME を作り、合成フィクスチャを1つ置く。

    bwrap の --tmpfs /tmp はサンドボックス内の /tmp を差し替えるだけなので、
    HOME に使う実体はホスト側に置く。
    """
    sb = tempfile.mkdtemp(prefix=SANDBOX_PREFIX)
    os.makedirs(
        os.path.join(sb, ".claude", "projects", FIXTURE_PROJECT, "memory"),
        exist_ok=True,
    )
    return sb


def build_bwrap(repo, sandbox, extra_ro=()):
    """ホスト全体を読み取り専用にし、HOME だけを書き込み可能に戻す。

    --ro-bind で HOME を被せてはいけない。Read-only file system で
    HOME 配下への書き込みがすべて失敗する。
    """
    home = os.path.expanduser("~")
    argv = [
        "bwrap",
        "--ro-bind", "/", "/",
        "--dev", "/dev", "--proc", "/proc", "--tmpfs", "/tmp",
        "--bind", sandbox, home,
    ]
    for p in RO_BINDS:
        if os.path.exists(p):
            argv += ["--ro-bind", p, p]
    argv += ["--ro-bind", repo, repo]
    common = git_common_dir(repo)
    if common and os.path.exists(common) and not common.startswith(repo + os.sep):
        argv += ["--ro-bind", common, common]
    for src, dst in extra_ro:
        argv += ["--ro-bind", src, dst]
    argv += ["--chdir", repo, "--"]
    return argv


def run_cmd_in_sandbox(repo, sandbox, cmd, extra_ro=()):
    """サンドボックスの内側で1つのコマンドを走らせる。

    git ls-files もここを通す。外側で走らせると、対象を数えた環境と
    走らせる環境が食い違い、片方にしか無いファイルを見落とす。
    """
    argv = build_bwrap(repo, sandbox, extra_ro) + list(cmd)
    env = dict(os.environ)
    env["VERIFY_TESTS_SANDBOX"] = "1"
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    proc = subprocess.run(argv, capture_output=True, text=True, env=env)
    return proc.returncode, proc.stdout, proc.stderr


def sandbox_started(repo, sandbox):
    """bwrap の起動そのものが失敗したかを、終了コード以外で見る。

    bwrap は起動に失敗したとき終了コード1を返し、これは pytest の
    「テストが落ちた」と同じ値になる。区別を付けないと、隔離が一度も
    働いていないのに「テストが落ちた」と報告することになる。
    """
    rc, out, _ = run_cmd_in_sandbox(
        repo, sandbox, ["sh", "-c", f"printf ok > {MARKER}; cat {MARKER}"]
    )
    return rc == 0 and out.strip() == "ok"


def tracked_files(repo, sandbox):
    rc, out, _ = run_cmd_in_sandbox(repo, sandbox, ["git", "ls-files"])
    if rc != 0:
        return None
    return [ln for ln in out.splitlines() if ln.strip()]


def collected_files(repo, sandbox):
    """--collect-only -q の出力からファイルの集合を取る。

    :: を含む行だけを採る。-q の出力には集計行や警告も混ざるため、
    外さないと集計行が偽のパスとして差分に出る。
    木構造の出力は形式が変わりやすいので使わない。
    """
    rc, out, err = run_cmd_in_sandbox(
        repo, sandbox,
        ["python3", "-m", "pytest", "--collect-only", "-q", "-p", "no:cacheprovider"],
    )
    files = set()
    for ln in out.splitlines():
        if "::" not in ln:
            continue
        files.add(os.path.normpath(os.path.join(repo, ln.split("::", 1)[0])))
    return rc, files, out + err


def run_python(repo, sandbox, extra_args=()):
    rc, out, err = run_cmd_in_sandbox(
        repo, sandbox,
        ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", *extra_args],
    )
    return rc, out + err


def run_shell(repo, sandbox, sh_files, extra_ro=()):
    """shell はファイル単位の終了コードだけを見る（Level 1）。

    集計行のパースはしない。3形式に割れており、5本は集計行を持たない。
    ケース単位の identity は #18 で bats へ移してから取る。
    """
    results = {}
    for rel in sh_files:
        # extra_ro を必ず渡す。受け取るだけで転送しないと、Task 10 の重ね掛けが
        # 黙って効かないまま走る。引数が構文的には在るので TypeError にもならず、
        # shell レーンの trust root だけが静かに無効化される。
        rc, _, _ = run_cmd_in_sandbox(
            repo, sandbox, ["bash", os.path.join(repo, rel)], extra_ro
        )
        results[rel] = rc
    return results


# 監視対象。環境変数で使い捨てのパスへ差し替えられる。
DEFAULT_WATCHED = [
    os.path.expanduser("~/.claude/logs/memory-recall.log*"),
    os.path.expanduser("~/.claude/projects/*/memory/.embeddings.json*"),
    os.path.expanduser("~/.claude/projects/*/memory/*.md"),
    os.path.expanduser("~/.local/share/chezmoi"),
