    discover_only = "--discover-only" in argv
    passthrough = argv[argv.index("--") + 1:] if "--" in argv else None
    if passthrough is not None and (strict or discover_only):
        print("実行できなかった: -- は --strict / --discover-only と併用できません")
        return 1

