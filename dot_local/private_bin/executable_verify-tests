        i = argv.index("--selftest-worktree-run")
        tree, script = ast.literal_eval(argv[i + 1])
        tree = os.path.abspath(tree)
        sandbox = make_sandbox_home()
        try:
            copy = make_worktree_copy(tree, sandbox)
