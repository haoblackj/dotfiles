#!/bin/bash
set -eu

{{ template "brew-env.sh" }}
# 導入済み判定はテンプレートの lookPath でなく実行時に行う。lookPath だと導入前後で
# レンダリング結果（内容ハッシュ）が変わり、導入後に一度「実行待ち」が出る。
if command -v pyenv >/dev/null 2>&1; then
  echo "pyenvインストール済"
else
  echo "pyenvビルド依存パッケージインストール"
  sudo apt update && sudo apt install -y \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncurses-dev \
    libffi-dev \
    liblzma-dev \
    tk-dev \
    uuid-dev \
    libnss3-dev \
    libgdbm-dev \
    libdb-dev \
    libexpat1-dev

  echo "pyenvインストール開始"
  brew install pyenv
  brew install pyenv-virtualenv
fi
